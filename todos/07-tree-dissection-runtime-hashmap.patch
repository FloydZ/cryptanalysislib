+	/// same as `dissection4`, but `L2`, `L4` and the intermediate list are
+	/// hashmaps instead of sorted lists:
+	/// 	- `L2` and `L4` are hashed on [0, k_upper1)
+	/// 	- iL (pairs of indices into `L1`, `L2`) is hashed on the next (at
+	///		most 16) bits after `k_upper1`. The matches are checked on [0, k_upper2).
+	/// NOTE: the lists are not changed. Allocates three hashmaps.
+	/// NOTE: an element is dropped, if its bucket is full (`bucketsize`).
+	/// \tparam k_upper1 the intermediate targets are enumerated on [0, k_upper1)
+	/// \tparam k_upper2 the outputs are equal to the target on [0, k_upper2)
+	/// \tparam bucketsize number of elements per bucket of all hashmaps
+	/// \param out output list, is cleared
+	/// \param L1 const
+	/// \param L2 const
+	/// \param L3 const
+	/// \param L4 const
+	/// \param target
+	template<const uint32_t k_upper1,
+			 const uint32_t k_upper2,
+			 const uint32_t bucketsize=16>
+	static void dissection4_hashmap(List &out,
+									const List &L1, const List &L2,
+									const List &L3, const List &L4,
+									const LabelType &target) noexcept {
+		static_assert(k_upper1 < k_upper2);
+		constexpr uint32_t filter = -1u;
+		// number of hashed bits of the intermediate list
+		constexpr uint32_t hbits = (k_upper2 - k_upper1) < 16u ? (k_upper2 - k_upper1) : 16u;
+
+		using D = typename LabelType::DataType;
+		using E = std::pair<size_t, size_t>;
+		constexpr static SimpleHashMapConfig configL {
+			bucketsize, 1ull << k_upper1, 1
+		};
+		constexpr static SimpleHashMapConfig configIL {
+			bucketsize, 1ull << hbits, 1
+		};
+		using HML  = SimpleHashMap<D, size_t, configL,  Hash<D, 0, k_upper1, 2>>;
+		using HMIL = SimpleHashMap<D,      E, configIL, Hash<D, k_upper1, k_upper1 + hbits, 2>>;
+		using LoadL  = typename HML::load_type;
+		using LoadIL = typename HMIL::load_type;
+		HML *hm2 = new HML{};
+		HML *hm4 = new HML{};
+		HMIL *hmiL = new HMIL{};
+
+		out.set_load(0);
+		for (size_t i = 0; i < L2.load(); ++i) {
+			hm2->insert(L2[i].label.value(), i);
+		}
+		for (size_t i = 0; i < L4.load(); ++i) {
+			hm4->insert(L4[i].label.value(), i);
+		}
+
+		ElementType tmpe1;
+		LabelType sigma_M, sigma_t, tprime, s;
+		LoadL load = 0;
+		LoadIL loadiL = 0;
+		for (size_t sigma_M_ = 0; sigma_M_ < (1ull << k_upper1); ++sigma_M_) {
+			hmiL->clear();
+			sigma_M.set(sigma_M_, 0);
+			for (size_t i = 0; i < L1.load(); ++i) {
+				LabelType::sub(sigma_t, sigma_M, L1[i].label, 0, k_upper1);
+				const size_t sj = hm2->find(sigma_t.value(), load);
+				for (size_t j = sj; j < sj + load; ++j) {
+					const size_t b = (*hm2)[j];
+					LabelType::add(s, L1[i].label, L2[b].label);
+					hmiL->insert(s.value(), E{i, b});
+				}
+			}
+
+			LabelType::sub(sigma_t, target, sigma_M);
+			for (size_t k = 0; k < L3.load(); ++k) {
+				LabelType::sub(s, sigma_t, L3[k].label);
+				const size_t sl = hm4->find(s.value(), load);
+				for (size_t l = sl; l < sl + load; ++l) {
+					const size_t b = (*hm4)[l];
+					LabelType::sub(tprime, target, L3[k].label);
+					LabelType::sub(tprime, tprime, L4[b].label);
+					const size_t so = hmiL->find(tprime.value(), loadiL);
+					for (size_t o = so; o < so + loadiL; ++o) {
+						const E a = (*hmiL)[o];
+						LabelType::add(s, L1[a.first].label, L2[a.second].label);
+						if (!tprime.is_equal(s, 0, k_upper2)) { continue; }
+
+						ElementType::add(tmpe1, L1[a.first], L2[a.second]);
+						ElementType::add(tmpe1, tmpe1, L3[k]);
+						out.add_and_append(tmpe1, L4[b], 0, k_upper2, filter);
+					}
+				}
+			}
+		}
+
+		delete hm2;
+		delete hm4;
+		delete hmiL;
+	}
 #endif//CRYPTANALYSISLIB_DISSECTION_H
