+/// atomic type with the `std::atomic` interface
+template<class A>
+struct test_atomic : public std::atomic<A> {
+	using std::atomic<A>::atomic;
+	using std::atomic<A>::operator=;
+};
+
+/// FreeList with an explicitly given atomic type
+TEST(FreeList, atomic) {
+	FreeList<uint64_t, cryptanalysislib::allocator, test_atomic> l;
+	for (uint64_t i = 1; i <= 100; ++i) { EXPECT_EQ(l.insert(i), 0); }
+	EXPECT_EQ(l.size(), 100u);
+	for (uint64_t i = 1; i <= 100; ++i) { EXPECT_EQ(l.contains(i), 1); }
+	EXPECT_EQ(l.remove(50), 0);
+	EXPECT_EQ(l.contains(50), 0);
+}
