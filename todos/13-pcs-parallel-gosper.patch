+	// with a flavour: the collision is one of x -> f(x ^ 1)
+	const auto flavour = [](const uint32_t &x) { return x ^ 1u; };
+	uint32_t x = 0, y = 0;
+	const bool found = S::run(par_if(true), f, flavour, x, y, 1u << 10u, 1u << 20u);
+	EXPECT_TRUE(found);
+	EXPECT_NE(x, y);
+	EXPECT_EQ(f(flavour(x)), f(flavour(y)));
+}
 
