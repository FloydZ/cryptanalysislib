+/// Euclidean metric for `kd_tree`
+struct kd_tree_euclidean_metric {
+	/// \return distance between the points a and b (K coordinates)
+	template<typename D, const int K>
+	static D dist(const D (&a)[K], const D (&b)[K]) noexcept {
+		D sum = 0;
+		for (int i = 0; i < K; i++) { sum += (a[i] - b[i]) * (a[i] - b[i]); }
+		return std::sqrt(sum);
+	}
+
+	/// \return distance between the point p and the box [from, to]
+	/// 	(0 inside), must be a lower bound of dist(p, x) for every x in the box
+	template<typename D, const int K>
+	static D box_dist(const D (&p)[K], const D (&from)[K], const D (&to)[K]) noexcept {
+		D sum = 0;
+		for (int i = 0; i < K; i++) {
+			if (p[i] < from[i]) { sum += (from[i] - p[i]) * (from[i] - p[i]); }
+			else if (p[i] > to[i]) { sum += (p[i] - to[i]) * (p[i] - to[i]); }
+		}
+		return std::sqrt(sum);
+	}
+};
+
+/// Manhattan (L1) metric for `kd_tree`
+struct kd_tree_manhattan_metric {
+	template<typename D, const int K>
+	static D dist(const D (&a)[K], const D (&b)[K]) noexcept {
+		D sum = 0;
+		for (int i = 0; i < K; i++) { sum += (a[i] < b[i]) ? (b[i] - a[i]) : (a[i] - b[i]); }
+		return sum;
+	}
+
+	template<typename D, const int K>
+	static D box_dist(const D (&p)[K], const D (&from)[K], const D (&to)[K]) noexcept {
+		D sum = 0;
+		for (int i = 0; i < K; i++) {
+			if (p[i] < from[i]) { sum += from[i] - p[i]; }
+			else if (p[i] > to[i]) { sum += p[i] - to[i]; }
+		}
+		return sum;
+	}
+};
 
