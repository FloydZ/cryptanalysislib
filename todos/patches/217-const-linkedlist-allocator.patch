+/// the nodes are allocated with the Allocator template parameter
+static std::atomic<int64_t> live_nodes{0};
+template<class T>
+struct counting_allocator {
+	using value_type = T;
+	counting_allocator() noexcept = default;
+	template<class U> counting_allocator(const counting_allocator<U> &) noexcept {}
+	T *allocate(const size_t n) { live_nodes += int64_t(n); return std::allocator<T>{}.allocate(n); }
+	void deallocate(T *p, const size_t n) noexcept { live_nodes -= int64_t(n); std::allocator<T>{}.deallocate(p, n); }
+};
+
+TEST(ConstFreeList, allocator_is_used) {
+	ConstFreeList<uint64_t, counting_allocator> l;
+	for (uint64_t i = 0; i < 100; ++i) { l.insert(i); }
+	EXPECT_EQ(live_nodes.load(), 100);
+	EXPECT_TRUE(l.contains(42));
+	l.clear();
+	EXPECT_EQ(live_nodes.load(), 0);
+}
