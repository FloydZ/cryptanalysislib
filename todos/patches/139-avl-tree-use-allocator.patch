diff --git a/tests/container/avl_tree.cpp b/tests/container/avl_tree.cpp
index e1834ae..411b6ae 100644
--- a/tests/container/avl_tree.cpp
+++ b/tests/container/avl_tree.cpp
@@ -1,3 +1,4 @@
+#include <memory>
 #include <gtest/gtest.h>
 #include <iostream>
 
@@ -355,6 +356,37 @@ TEST(AVLTree, Info) {
 
 
 
+/// counts live allocations, to check that the tree uses its allocator
+static int64_t live_nodes = 0;
+template<class T>
+struct counting_allocator {
+	using value_type = T;
+	counting_allocator() noexcept = default;
+	template<class U> counting_allocator(const counting_allocator<U> &) noexcept {}
+	T *allocate(const size_t n) { live_nodes += int64_t(n); return std::allocator<T>{}.allocate(n); }
+	void deallocate(T *p, const size_t n) noexcept { live_nodes -= int64_t(n); std::allocator<T>{}.deallocate(p, n); }
+};
+
+TEST(AvlTreeList, allocator_is_used) {
+	{
+		AvlTreeList<int, counting_allocator> t;
+		for (int i = 0; i < 1000; ++i) { t.push_back(i); }
+		EXPECT_EQ(live_nodes, 1000);
+		for (int i = 0; i < 500; ++i) { t.erase(0); }
+		EXPECT_EQ(live_nodes, 500);
+		EXPECT_EQ(t[0], 500);
+		{
+			AvlTreeList<int, counting_allocator> copy(t);
+			EXPECT_EQ(live_nodes, 1000);
+		}
+		EXPECT_EQ(live_nodes, 500);
+		t.clear();
+		EXPECT_EQ(live_nodes, 0);
+		t.push_back(1);
+	}
+	EXPECT_EQ(live_nodes, 0);
+}
+
 int main(int argc, char **argv) {
     InitGoogleTest(&argc, argv);
     return RUN_ALL_TESTS();
