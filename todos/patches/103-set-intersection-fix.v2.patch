+        /// \return first position `p` in [lo, hi) with !(x[p] < v), hi if none
+        template <typename T>
+        constexpr size_t intersection_lower_pos(T const *x,
+                                                size_t lo,
+                                                size_t hi,
+                                                const T v) noexcept {
+            while (lo < hi) {
+                const size_t mid = lo + (hi - lo) / 2;
+                if (x[mid] < v) { lo = mid + 1; } else { hi = mid; }
+            }
+            return lo;
+        }
