+	public:
+		using iterator_category = std::bidirectional_iterator_tag;
+		using value_type = T;
+		using difference_type = std::ptrdiff_t;
+		using pointer = std::conditional_t<is_const, const T *, T *>;
+		using reference = std::conditional_t<is_const, const T &, T &>;
