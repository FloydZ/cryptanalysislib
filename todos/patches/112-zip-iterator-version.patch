+/// iterator version: all sizes around the register widths, all unsigned
+/// types (AVX2 path) and a non contiguous/non integral one
+template<typename T>
+static void check_zip() {
+	for (size_t s = 0; s <= 100; ++s) {
+		std::vector<T> a(s), b(s), out(2 * s + 1, T(7)), e(2 * s);
+		for (size_t i = 0; i < s; ++i) { a[i] = T(i * 3 + 1); b[i] = T(~(i * 5)); e[2 * i] = a[i]; e[2 * i + 1] = b[i]; }
+		const auto r = cryptanalysislib::zip(a.begin(), a.end(), b.begin(), out.begin());
+		ASSERT_EQ(r - out.begin(), ptrdiff_t(2 * s));
+		ASSERT_TRUE(std::equal(e.begin(), e.end(), out.begin())) << s;
+		ASSERT_EQ(out[2 * s], T(7)) << "wrote past the end " << s;
+	}
+}
+TEST(zip, iterator_version) {
+	check_zip<uint8_t>(); check_zip<uint16_t>(); check_zip<uint32_t>(); check_zip<uint64_t>();
+
+	std::list<std::string> a = {"a", "b"}, b = {"x", "y"};
+	std::vector<std::string> out(4);
+	cryptanalysislib::zip(a.begin(), a.end(), b.begin(), out.begin());
+	EXPECT_EQ(out, (std::vector<std::string>{"a", "x", "b", "y"}));
+
+	constexpr auto c = []() { int x[2] = {1, 2}, y[2] = {3, 4}, o[4] = {}; cryptanalysislib::zip(x, x + 2, y, o); return o[0] * 1000 + o[1] * 100 + o[2] * 10 + o[3]; }();
+	static_assert(c == 1324);
+}
