 namespace cryptanalysislib {
     /// Configuration for min algorithms with SIMD and threading settings
@@ -179,6 +179,17 @@ ForwardIt min_element(ForwardIt first,
     if (first == last) {
         return last;
     }
+
+    // SIMD: minimum via `min_simd_uXX`, then its first occurrence via the
+    // SIMD `find`
+    using T = std::iter_value_t<ForwardIt>;
+    if constexpr (std::unsigned_integral<T> && std::contiguous_iterator<ForwardIt>) {
+        const size_t len = static_cast<size_t>(last - first);
+        if (len >= algorithmMinConfig.min_size_simd) {
+            const T m = internal::min_simd_uXX<T>(std::to_address(first), len);
+            return cryptanalysislib::find(first, last, m);
+        }
+    }
  
     ForwardIt smallest = first;
  
diff --git a/tests/algorithm/min.cpp b/tests/algorithm/min.cpp
index db0e12c..f5c62bb 100644
--- a/tests/algorithm/min.cpp
+++ b/tests/algorithm/min.cpp
@@ -82,7 +82,21 @@ TYPED_TEST_P(Min, scalar) {
 	EXPECT_EQ(min(a, b), a);
 }
 
-REGISTER_TYPED_TEST_SUITE_P(Min, simple, simd, simd_rng, multithreading, multithreading_rnd, scalar);
+/// min_element against std::min_element: sizes around the SIMD threshold,
+/// few distinct values, so the minimum occurs repeatedly (first occurrence)
+TYPED_TEST_P(Min, min_element) {
+	for (size_t s = 1; s <= 300; ++s) {
+		std::vector<TypeParam> in(s);
+		for (auto &x : in) { x = TypeParam(rng() % 7u); }
+		const auto e = std::min_element(in.begin(), in.end());
+		EXPECT_EQ(cryptanalysislib::min_element(in.begin(), in.end()), e) << s;
+		EXPECT_EQ(cryptanalysislib::min_element(in.begin(), in.end(), std::less<TypeParam>()), e) << s;
+	}
+	std::vector<TypeParam> empty;
+	EXPECT_EQ(cryptanalysislib::min_element(empty.begin(), empty.end()), empty.end());
+}
+
+REGISTER_TYPED_TEST_SUITE_P(Min, simple, simd, simd_rng, multithreading, multithreading_rnd, scalar, min_element);
 using MyTypes = ::testing::Types<uint8_t, uint16_t, uint32_t, uint64_t>;
 INSTANTIATE_TYPED_TEST_SUITE_P(My, Min, MyTypes);
 
