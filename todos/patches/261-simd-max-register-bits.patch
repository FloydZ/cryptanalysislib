diff --git a/src/simd/simd.h b/src/simd/simd.h
index f2bcb2c..86612d7 100644
--- a/src/simd/simd.h
+++ b/src/simd/simd.h
@@ -199,6 +199,23 @@ public:
 };
 
 
+namespace cryptanalysislib {
+	/// \return width in bits of the largest SIMD register enabled at compile
+	/// 	time: 512 (`USE_AVX512F`), 256 (`USE_AVX2`), 128 (NEON/SSE2),
+	/// 	otherwise 64 (generic SWAR fallback).
+	/// NOTE: e.g. the maximal useful alignment (in bits) of SIMD data
+	[[nodiscard]] constexpr inline uint32_t simd_max_register_bits() noexcept {
+#if defined(USE_AVX512F)
+		return 512u;
+#elif defined(USE_AVX2)
+		return 256u;
+#elif defined(USE_ARM) || defined(USE_NEON) || defined(USE_SSE2) || defined(__SSE2__)
+		return 128u;
+#else
+		return 64u;
+#endif
+	}
+} // end namespace cryptanalysislib
 
 #if defined(USE_AVX2)
 #include "simd/avx2.h"
diff --git a/src/matrix/binary_matrix.h b/src/matrix/binary_matrix.h
index c93c3e0..17f47f2 100644
--- a/src/matrix/binary_matrix.h
+++ b/src/matrix/binary_matrix.h
@@ -48,8 +48,13 @@ public:
 	constexpr static uint32_t limbs = (ncols + RADIX - 1u) / RADIX;
 
 	// number of limbs actually allocated
-	// TODO: write a SIMD abstraction layer (static global function?) which gives you the max aligment the computer supports.
-	constexpr static uint32_t alignment = 256;// NOTE: currently that's chosen for avx
+	// NOTE: in bits. The row kernels (`row_xor`, `xor_avx1_new`, ...) process
+	// 	one `uint8x32_t` per step, so the padding must be exactly that width.
+	// 	`cryptanalysislib::simd_max_register_bits()` gives the widest register
+	// 	of the machine, but using it here would also require the kernels to
+	// 	step by that width (with 512 they would skip half of every block).
+	constexpr static uint32_t alignment = sizeof(uint8x32_t) * 8u;
+	static_assert(alignment == 256u);
 	constexpr static uint32_t fraction = alignment / RADIX;
 	constexpr static uint32_t padded_limbs = ((ncols + alignment - 1u) / alignment) * fraction;
 	constexpr static uint32_t padded_simd_limbs = (ncols + alignment - 1u) / alignment;
diff --git a/tests/simd/simd.cpp b/tests/simd/simd.cpp
index 7550466..ac0bbde 100644
--- a/tests/simd/simd.cpp
+++ b/tests/simd/simd.cpp
@@ -170,6 +170,16 @@ using ::testing::UnitTest;
 #undef S
 #undef T
 
+TEST(simd, max_register_bits) {
+	constexpr uint32_t b = cryptanalysislib::simd_max_register_bits();
+	static_assert((b == 64u) || (b == 128u) || (b == 256u) || (b == 512u));
+#if defined(USE_AVX512F)
+	EXPECT_EQ(b, 512u);
+#elif defined(USE_AVX2)
+	EXPECT_EQ(b, 256u);
+#endif
+}
