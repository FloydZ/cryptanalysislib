+		// SIMD version for `+` on contiguous uint32_t data
+		if constexpr (std::contiguous_iterator<InputIt> &&
+		              std::contiguous_iterator<OutputIt> &&
+		              std::is_same_v<T, uint32_t> &&
+		              std::is_same_v<std::iter_value_t<OutputIt>, T> &&
+		              std::is_same_v<BinaryOp, std::plus<T>>) {
+			const size_t n = static_cast<size_t>(last - first);
+			internal::exclusive_scan_u32_avx2(std::to_address(first), std::to_address(d_first), n, init);
+			return d_first + n;
+		}
+#endif
 
+    	// NOTE: each element is read before its output is written, so
+    	// 	`d_first == first` (inplace) works. Before, out[0] = init was
+    	// 	written first, and `last -= 1` needed random access iterators.
+    	T acc = init;
     	while (first != last) {
-    		acc = op(std::move(acc), *first);
-    		*(d_first++) = acc;
-    		first += 1;
+    		const T v = *first;
+    		++first;
+    		*d_first = acc;
+    		++d_first;
+    		acc = op(std::move(acc), v);
     	}
 
     	return d_first;
diff --git a/tests/algorithm/exclusive_scan.cpp b/tests/algorithm/exclusive_scan.cpp
index d8423d3..de417b5 100644
--- a/tests/algorithm/exclusive_scan.cpp
+++ b/tests/algorithm/exclusive_scan.cpp
@@ -53,7 +53,24 @@ TYPED_TEST_P(Reduce, multithreading) {
     }
 }
 
-REGISTER_TYPED_TEST_SUITE_P(Reduce, simple, multithreading);
+/// all sizes around the SIMD block length, random data, against
+/// `std::exclusive_scan`, out of place and inplace
+TYPED_TEST_P(Reduce, simd_all_sizes) {
+	for (size_t s = 0; s <= 300; ++s) {
+		std::vector<TypeParam> in(s), out(s), e(s);
+		for (auto &x : in) { x = TypeParam(rand()); }
+		const TypeParam init = TypeParam(rand());
+		std::exclusive_scan(in.begin(), in.end(), e.begin(), init);
+
+		cryptanalysislib::exclusive_scan(in.begin(), in.end(), out.begin(), init);
+		EXPECT_EQ(out, e) << s;
+
+		cryptanalysislib::exclusive_scan(in.begin(), in.end(), in.begin(), init);
+		EXPECT_EQ(in, e) << s;
+	}
+}
+
+REGISTER_TYPED_TEST_SUITE_P(Reduce, simple, multithreading, simd_all_sizes);
 using MyTypes = ::testing::Types<uint8_t, uint16_t, uint32_t, uint64_t>;
 INSTANTIATE_TYPED_TEST_SUITE_P(My, Reduce, MyTypes);
 
