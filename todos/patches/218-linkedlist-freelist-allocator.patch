+/// FreeList: nodes (incl. the sentinels) from the Allocator template parameter
+static std::atomic<int64_t> live_free_nodes{0};
+template<class T>
+struct counting_allocator2 {
+	using value_type = T;
+	counting_allocator2() noexcept = default;
+	template<class U> counting_allocator2(const counting_allocator2<U> &) noexcept {}
+	T *allocate(const size_t n) { live_free_nodes += int64_t(n); return std::allocator<T>{}.allocate(n); }
+	void deallocate(T *p, const size_t n) noexcept { live_free_nodes -= int64_t(n); std::allocator<T>{}.deallocate(p, n); }
+};
+
+TEST(FreeList, allocator_is_used) {
+	{
+		FreeList<uint64_t, counting_allocator2> l;
+		EXPECT_EQ(live_free_nodes.load(), 2); // head + tail
+		for (uint64_t i = 1; i <= 100; ++i) { l.insert(i); }
+		EXPECT_GE(live_free_nodes.load(), 2);
+	}
+	EXPECT_EQ(live_free_nodes.load(), 0);
+}
