+	struct Walker {
+		using C = Combinations_Fq_Chase<len, q, wt>;
+		ChangeList chase_cl;
+		std::vector<uint16_t> gray_cl = std::vector<uint16_t>(C::gray_size ? C::gray_size : 1u);
+		std::array<uint32_t, wt> cs; // currently set coordinates
+		std::array<uint32_t, len> v; // current values
+		size_t i = 0, j = 0;
+
+		Walker() noexcept {
+			C c{};
+			if constexpr (q > 2) { c.changelist_mixed_radix_grey(gray_cl.data()); }
+			c.template changelist_chase<false>(chase_cl);
+			reset();
+		}
