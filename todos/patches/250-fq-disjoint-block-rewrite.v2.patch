+		/// back to the start configuration: `[0, wt)` set to one
+		constexpr void reset() noexcept {
+			i = 0; j = 0;
+			for (uint32_t t = 0; t < len; ++t) { v[t] = t < wt; }
+			for (uint32_t t = 0; t < wt; ++t) { cs[t] = t; }
