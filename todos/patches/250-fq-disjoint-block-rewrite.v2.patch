+/// weights, block layout, distinctness, labels (incl. syndrome in L1) and the
+/// hashmaps of L1 and L3
+template<const uint32_t mitm_w, const uint32_t noreps_w>
+static void disjoint_block_full_check() {
+	constexpr uint32_t split = n / 2;
+	using Enumerator = ListEnumerateMultiDisjointBlock<List, n, q, mitm_w, noreps_w, split>;
+	constexpr size_t list_size = Enumerator::LIST_SIZE;
+	static_assert(list_size == compute_combinations_fq_chase_list_size<Enumerator::mitmlen_half, q, mitm_w>() *
+	                           compute_combinations_fq_chase_list_size<Enumerator::norepslen_quarter, q, noreps_w>());
+
+	using HK = uint64_t;
+	constexpr static SimpleHashMapConfig cfg{64, 1u << l, 1};
+	using HM = SimpleHashMap<HK, V, cfg, Hash<HK, 0, l, 2>>;
+	auto extractor = [](const Label label) -> HK {
+		constexpr uint64_t mask = (1ull << l) - 1ull;
+		return label.ptr()[0] & mask;
+	};
+
+	List L1(list_size), L2(list_size), L3(list_size), L4(list_size);
+	auto *hm = new HM{}, *hm3 = new HM{};
+	Matrix HT;
+	HT.random();
+	Label syndrome;
+	syndrome.random();
+	Enumerator enumerator{HT, 0, &syndrome};
+	enumerator.template run<HM, decltype(extractor)>(L1, L2, L3, L4, 0, hm, &extractor, hm3);
+
+	const List *lists[4] = {&L1, &L2, &L3, &L4};
+	std::vector<bool> covered(n, false);
+	for (uint32_t k = 0; k < 4; ++k) {
+		const List &L = *lists[k];
+		const uint32_t mb = (k & 1u) * Enumerator::mitmlen_offset;
+		const uint32_t nb = Enumerator::noreps_base + k * Enumerator::norepslen_offset;
+		for (size_t i = 0; i < list_size; ++i) {
+			const auto &v = L.data_value(i);
+			EXPECT_EQ(v.popcnt(), mitm_w + noreps_w);
+			EXPECT_EQ(v.popcnt(mb, mb + Enumerator::mitmlen_half), mitm_w);
+			EXPECT_EQ(v.popcnt(nb, nb + Enumerator::norepslen_quarter), noreps_w);
+			for (uint32_t j = nb; j < nb + Enumerator::norepslen_quarter; ++j) {
+				covered[j] = covered[j] || v.get(j);
+			}
+
+			Element t = L[i];
+			t.recalculate_label(HT);
+			if (k == 0) { Label::add(t.label, t.label, syndrome); }
+			EXPECT_TRUE(t.label.is_equal(L.data_label(i)));
+
+			for (size_t j = 0; j < i; ++j) {
+				EXPECT_FALSE(v.is_equal(L.data_value(j)));
+			}
+		}
+	}
+
+	// every coordinate of the noreps part is enumerated
+	for (uint32_t j = split; j < n; ++j) { EXPECT_TRUE(covered[j]); }
+
+	auto contains = [&](const HM *h, const List &L, const size_t i) {
+		typename HM::load_type load = 0;
+		const auto pos = h->find(extractor(L.data_label(i)), load);
+		for (size_t j = 0; j < load; ++j) {
+			if (h->ptr(pos + j)[0] == i) { return true; }
+		}
+		return false;
+	};
+	for (size_t i = 0; i < list_size; ++i) {
+		EXPECT_TRUE(contains(hm, L1, i));
+		EXPECT_TRUE(contains(hm3, L3, i));
+	}
+
+	delete hm; delete hm3;
+}
+
+TEST(ListEnumerateMultiDisjointBlock, full_check) {
+	disjoint_block_full_check<1, 1>();
+	disjoint_block_full_check<2, 1>();
+	disjoint_block_full_check<2, 2>();
+}
+
 
