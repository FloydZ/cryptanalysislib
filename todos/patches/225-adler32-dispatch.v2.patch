+
+/// Adler-32 with the fastest available implementation (scalar, AVX2,
+/// AVX-512): on the first call all candidates are benchmarked once on a
+/// fixed 4 KiB buffer (like `binary_search_dispatch` in `search/binary.h`),
+/// the choice is a function local static (thread safe initialization).
+/// \param val[in] initial Adler-32 value (1 for a new checksum)
+/// \param in[in] input data
+/// \param in_len[in] length of the input in bytes
+/// \return the Adler-32 checksum, identical for all implementations
+static inline uint32_t adler32_dispatch(const uint32_t val,
+                                        const uint8_t *in,
+                                        const size_t in_len) noexcept {
+	using FF = uint32_t (*)(uint32_t, const uint8_t *, size_t);
+	static FF functions[] = {
+		adler32,
+#ifdef USE_AVX2
+		avx2_adler32,
+#endif
+#ifdef USE_AVX512F
+		avx512_adler32,
+#endif
+	};
+
+	static const FF best = []() noexcept {
+		static uint8_t buf[4096];
+		for (size_t i = 0; i < sizeof(buf); ++i) { buf[i] = uint8_t(i * 131u + 7u); }
+		FF out = functions[0];
+		generic_dispatch(out, functions, sizeof(functions) / sizeof(functions[0]),
+		                 uint32_t(1), (const uint8_t *)buf, sizeof(buf));
+		return out;
+	}();
+
+	return best(val, in, in_len);
+}
 #endif
diff --git a/tests/hash/adler32.cpp b/tests/hash/adler32.cpp
index 72630f7..0f02545 100644
--- a/tests/hash/adler32.cpp
+++ b/tests/hash/adler32.cpp
@@ -31,6 +31,33 @@ TEST(Adler32, avx) {
 	free(data);
 }
 #endif
+
+/// all implementations and the dispatcher agree for all lengths 0..1024 and
+/// two start values (incl. the scalar reference from zlib's definition)
+TEST(Adler32, all_versions) {
+	constexpr static size_t size = 1024;
+	auto *data = (uint8_t *)malloc(size);
+	rng(data, size);
+
+	for (const uint32_t val : {1u, 0x12345678u}) {
+		for (size_t i = 0; i <= size; ++i) {
+			// reference: the definition, modulo 65521
+			uint32_t a = val & 0xffffu, b = val >> 16u;
+			for (size_t j = 0; j < i; ++j) { a = (a + data[j]) % 65521u; b = (b + a) % 65521u; }
+			const uint32_t e = (b << 16u) | a;
+			EXPECT_EQ(adler32(val, data, i), e) << i;
+			EXPECT_EQ(adler32_dispatch(val, data, i), e) << i;
+#ifdef USE_AVX2
+			EXPECT_EQ(avx2_adler32(val, data, i), e) << i;
+#endif
+#ifdef USE_AVX512F
+			EXPECT_EQ(avx512_adler32(val, data, i), e) << i;
+#endif
+		}
+	}
+	free(data);
+}
+
