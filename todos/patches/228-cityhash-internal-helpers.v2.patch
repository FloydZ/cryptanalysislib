+/// CityHash (Google, Geoff Pike and Jyrki Alakuijala), 32 bit and 64 bit
+/// versions: fast non-cryptographic hashes of byte strings.
+namespace cryptanalysislib::hash::internal {
+	/// unaligned little endian load of 8 bytes
+	inline static uint64_t fetch64(const char *p) noexcept {
+		uint64_t r;
+		__builtin_memcpy(&r, p, sizeof(r));
+		return r;
+	}
 
