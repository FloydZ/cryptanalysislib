+	/// rotate right by `shift` (taken modulo the bit width), branch free:
+	/// compiles to a single `ror`
+	template<typename T=uint32_t>
+	constexpr inline static T Rotate32(const T val, const int shift) noexcept {
+		constexpr unsigned bits = sizeof(T) * 8u;
+		const unsigned s = unsigned(shift) & (bits - 1u);
+		return T((val >> s) | (val << ((bits - s) & (bits - 1u))));
+	}
+} // end namespace cryptanalysislib::hash::internal
 
