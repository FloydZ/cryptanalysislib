+	/// unaligned little endian load of 4 bytes
+	inline static uint32_t fetch32(const char *p) noexcept {
+		uint32_t r;
+		__builtin_memcpy(&r, p, sizeof(r));
+		return r;
+	}
 
-template<typename T=uint32_t>
