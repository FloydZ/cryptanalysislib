diff --git a/src/atomic/atomic_primitives.h b/src/atomic/atomic_primitives.h
index 00b91f1..0f5d702 100644
--- a/src/atomic/atomic_primitives.h
+++ b/src/atomic/atomic_primitives.h
@@ -2,6 +2,7 @@
 #define CRYPTANALYSISLIB_ATOMIC_PRIMITIVES_H
 
 #include <atomic>
+#include <cassert>
 #include <cstdint>
 #include <memory>
 
@@ -280,6 +281,13 @@ namespace __atomic_impl {
 		return __ptr;
 	}
 
+	/// \return false for the memory orders not allowed as the failure order
+	/// 	of a compare exchange (`release`, `acq_rel`: a failed compare
+	/// 	exchange is only a load)
+	constexpr bool __is_valid_cmpexch_failure_order(const std::memory_order __m) noexcept {
+		return (__m != std::memory_order_release) && (__m != std::memory_order_acq_rel);
+	}
+
 	template<typename _Tp>
 	inline bool
 	__compare_exchange(_Tp &__val,
@@ -287,7 +295,8 @@ namespace __atomic_impl {
 	                   _Val<_Tp> &__i,
 	                   bool __is_weak,
 	                   std::memory_order __s, std::memory_order __f) noexcept {
-		// TODO static_assert(__is_valid_cmpexch_failure_order(__f));
+		// NOTE: `__f` is a runtime value, so no static_assert
+		assert(__is_valid_cmpexch_failure_order(__f));
 
 		using _Vp = _Val<_Tp>;
 
diff --git a/tests/atomic/atomic_primitives.cpp b/tests/atomic/atomic_primitives.cpp
index b142a46..bf84474 100644
--- a/tests/atomic/atomic_primitives.cpp
+++ b/tests/atomic/atomic_primitives.cpp
@@ -46,6 +46,21 @@ TEST(__clear_padding, simple) {
     EXPECT_EQ(*t, p);
 }
 
+TEST(primitives, cmpexch_failure_order) {
+	static_assert(__atomic_impl::__is_valid_cmpexch_failure_order(std::memory_order_relaxed));
+	static_assert(__atomic_impl::__is_valid_cmpexch_failure_order(std::memory_order_acquire));
+	static_assert(__atomic_impl::__is_valid_cmpexch_failure_order(std::memory_order_seq_cst));
+	static_assert(!__atomic_impl::__is_valid_cmpexch_failure_order(std::memory_order_release));
+	static_assert(!__atomic_impl::__is_valid_cmpexch_failure_order(std::memory_order_acq_rel));
+
+	uint64_t v = 5, e = 5;
+	EXPECT_TRUE(__atomic_impl::compare_exchange_strong(&v, e, 7ull, std::memory_order_acq_rel, std::memory_order_acquire));
+	EXPECT_EQ(v, 7u);
+	e = 5;
+	EXPECT_FALSE(__atomic_impl::compare_exchange_strong(&v, e, 9ull, std::memory_order_seq_cst, std::memory_order_relaxed));
+	EXPECT_EQ(e, 7u);
+}
+
 int main(int argc, char **argv) {
 	InitGoogleTest(&argc, argv);
 	return RUN_ALL_TESTS();
