+	/// forward iterator over the elements in ascending order
+	/// NOTE: invalidated by insert/erase/clear
+	class const_iterator {
+		friend class BTreeSet;
+		/// path from the root: (node, index of the next key of this node)
+		std::vector<std::pair<const Node *, key_type>> stack;
+
+		/// pushes the leftmost path below `n`
+		void descend_left(const Node *n) noexcept {
+			while (n != nullptr) {
+				stack.emplace_back(n, 0);
+				n = n->isLeaf() ? nullptr : n->children.front().get();
+			}
+		}
+
+		/// drops the exhausted nodes from the top of the stack
+		void normalize() noexcept {
+			while (!stack.empty() && (stack.back().second >= stack.back().first->keys.size())) {
+				stack.pop_back();
+			}
+		}
