@@ -40,3 +58,39 @@ OutputIt reverse_copy(BidirIt first,
     }
     return d_first;
 }
+
+/// Reverses [first, last) (parallel version): the first half is split
+/// between the threads, every thread swaps its part with the mirrored part
+/// of the second half.
+/// \param policy[in]: Execution policy specifying parallelization strategy
+/// \param first[in]: Iterator to the beginning of the range
+/// \param last[in]: Iterator to the end of the range
+template<class ExecPolicy,
+         class RandIt,
+         const cryptanalysislib::AlgorithmReverseConfig &config = cryptanalysislib::algorithmReverseConfig>
+#if __cplusplus > 201709L
+    requires std::random_access_iterator<RandIt>
+#endif
+void reverse(ExecPolicy &&policy,
+             RandIt first,
+             RandIt last) noexcept {
+    const size_t n = static_cast<size_t>(std::distance(first, last));
+    const uint32_t nthreads = cryptanalysislib::should_par(policy, config, n);
+    if (cryptanalysislib::is_seq<ExecPolicy>(policy) || nthreads < 2) {
+        ::reverse(first, last);
+        return;
+    }
+
+    const size_t half = n / 2;
+    auto &task_pool = *policy.pool();
+    std::vector<std::future<void>> futures;
+    for (uint32_t k = 0; k < nthreads; ++k) {
+        const size_t lo = (half * k) / nthreads, hi = (half * (k + 1)) / nthreads;
+        futures.emplace_back(task_pool.submit([first, n, lo, hi]() {
+            for (size_t i = lo; i < hi; ++i) {
+                std::iter_swap(first + i, first + (n - 1 - i));
+            }
+        }));
+    }
+    for (auto &f : futures) { f.wait(); }
+}
diff --git a/tests/algorithm/reverse.cpp b/tests/algorithm/reverse.cpp
new file mode 100644
index 0000000..aaf1f77
--- /dev/null
+++ b/tests/algorithm/reverse.cpp
@@ -0,0 +1,57 @@
+#include <gtest/gtest.h>
+#include <algorithm>
+#include <cstdint>
+#include <list>
+#include <vector>
+
+#include "random.h"
+#include "algorithm/reverse.h"
+
+using ::testing::InitGoogleTest;
+using namespace cryptanalysislib;
+
+template <typename T>
+class Reverse : public testing::Test {};
+TYPED_TEST_SUITE_P(Reverse);
+
+/// reverse against std::reverse, all sizes around the SIMD block sizes
+TYPED_TEST_P(Reverse, simple) {
+	for (size_t n = 0; n <= 300; ++n) {
+		std::vector<TypeParam> v(n);
+		for (auto &x : v) { x = TypeParam(rng()); }
+		auto e = v;
+		::reverse(v.begin(), v.end());
+		std::reverse(e.begin(), e.end());
+		EXPECT_EQ(v, e) << n;
+	}
+}
+
+TYPED_TEST_P(Reverse, multithreading) {
+	for (const size_t n : {size_t(1u << 21), size_t((1u << 21) + 3)}) {
+		std::vector<TypeParam> v(n);
+		for (auto &x : v) { x = TypeParam(rng()); }
+		auto e = v;
+		::reverse(par_if(true), v.begin(), v.end());
+		std::reverse(e.begin(), e.end());
+		EXPECT_EQ(v, e) << n;
+	}
+}
+
+REGISTER_TYPED_TEST_SUITE_P(Reverse, simple, multithreading);
+using MyTypes = ::testing::Types<uint8_t, uint16_t, uint32_t, uint64_t, int32_t>;
+INSTANTIATE_TYPED_TEST_SUITE_P(My, Reverse, MyTypes);
+
+TEST(reverse, non_contiguous_and_constexpr) {
+	std::list<int> l = {1, 2, 3};
+	::reverse(l.begin(), l.end());
+	EXPECT_EQ(l, (std::list<int>{3, 2, 1}));
+
+	constexpr auto r = []() { std::array<uint32_t, 5> a = {1, 2, 3, 4, 5}; ::reverse(a.begin(), a.end()); return a; }();
+	static_assert(r[0] == 5 && r[4] == 1);
+}
+
+int main(int argc, char **argv) {
+	InitGoogleTest(&argc, argv);
+	rng_seed(time(NULL));
+	return RUN_ALL_TESTS();
+}
