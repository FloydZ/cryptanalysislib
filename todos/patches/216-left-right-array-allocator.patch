diff --git a/tests/container/left_right_array_alloc.cpp b/tests/container/left_right_array_alloc.cpp
new file mode 100644
index 0000000..d5f2d9f
--- /dev/null
+++ b/tests/container/left_right_array_alloc.cpp
@@ -0,0 +1,33 @@
+#include <gtest/gtest.h>
+#include <cstdint>
+#include <memory>
+
+#include "container/left_right_array.h"
+
+using ::testing::InitGoogleTest;
+
+/// counts the live allocations, to check that the allocator is used
+static int64_t live = 0;
+template<class T>
+struct counting_allocator {
+	using value_type = T;
+	counting_allocator() noexcept = default;
+	template<class U> counting_allocator(const counting_allocator<U> &) noexcept {}
+	T *allocate(const size_t n) { live += 1; return std::allocator<T>{}.allocate(n); }
+	void deallocate(T *p, const size_t n) noexcept { live -= 1; std::allocator<T>{}.deallocate(p, n); }
+};
+
+TEST(left_right_array, allocator_is_used) {
+	{
+		left_right_array<counting_allocator> a(100);
+		EXPECT_EQ(live, 2);
+		EXPECT_EQ(a.get_free_idx_chg(5), 5u);
+		EXPECT_EQ(a.num_set(), 1u);
+	}
+	EXPECT_EQ(live, 0);
+}
+
+int main(int argc, char **argv) {
+	InitGoogleTest(&argc, argv);
+	return RUN_ALL_TESTS();
+}
