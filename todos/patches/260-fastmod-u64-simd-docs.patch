+template <uint64_t d>
+constexpr static uint64_t fastmod(const uint64_t x) noexcept {
+	static_assert(d != 0);
+	constexpr __uint128_t v = cryptanalysislib::math::internal::computeM_u64(d);
+	return cryptanalysislib::math::internal::fastmod_u64(x, v, d);
