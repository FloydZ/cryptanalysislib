+        static inline size_t intersect_u16_serial(uint16_t const *a, uint16_t const *b,
+                                                  const size_t n, const size_t m) noexcept {
+            size_t i = 0, j = 0, c = 0;
+            while ((i < n) && (j < m)) {
+                if (a[i] < b[j]) { ++i; }
+                else if (b[j] < a[i]) { ++j; }
+                else { ++c; ++i; ++j; }
+            }
+            return c;
+        }
