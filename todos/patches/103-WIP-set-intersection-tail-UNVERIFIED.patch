+            __mmask32 ret = 0;
+            for (uint32_t r = 0; r < 32; ++r) {
+                ret |= _mm512_cmpeq_epi16_mask(a, _mm512_permutexvar_epi16(idx, b));
+                idx = _mm512_and_si512(_mm512_add_epi16(idx, one), mask);
+            }
+            return ret;
+        }
 
