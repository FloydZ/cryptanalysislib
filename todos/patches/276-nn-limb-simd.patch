-	static void nn_bruteforce_simd_F2_32(const Index *out[2],
-	 									 const T *L, const T *R,
-										 const size_t el,
-										 const size_t er,
-										 const size_t max) noexcept {
+	static size_t nn_bruteforce_simd_F2_32(Index (*out)[2],
+	 									   const T *L, const T *R,
+										   const size_t el,
+										   const size_t er,
+										   const size_t max) noexcept {
+		static_assert(sizeof(T) == 4u);
+		static_assert(u > 0 && v > 0);
+		using S = uint32x8_t;
+		using L32 = typename S::limb_type;
