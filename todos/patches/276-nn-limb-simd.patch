-		// TODO code von bruteforce_simd_256_32_uxv klauen
-		// TODO: BM like nn version der gleichzeit auf verschieden limbs matched
-	}
+		if (max == 0) { return 0; }
+
+		auto add = [&](const size_t i, const size_t j) __attribute__((always_inline)) {
+			out[ctr][0] = i;
+			out[ctr][1] = j;
+			ctr += 1;
+			return ctr == max;
+		};
 
+		auto scalar = [&](const size_t i, const size_t j) __attribute__((always_inline)) {
+			if (cryptanalysislib::popcount::popcount(T(L[i] ^ R[j])) == w) {
+				return add(i, j);
+			}
+			return false;
+		};
+
+		const S wv = S::set1(w);
+		size_t i = 0;
+		for (; i + u <= el; i += u) {
+			S li[u];
+			for (uint32_t ui = 0; ui < u; ++ui) { li[ui] = S::set1(L32(L[i + ui])); }
+
+			size_t j = 0;
+			for (; j + 8u*v <= er; j += 8u*v) {
+				S r[v];
+				for (uint32_t vi = 0; vi < v; ++vi) {
+					r[vi] = S::unaligned_load((const L32 *)(R + j + 8u*vi));
+				}
+
+				for (uint32_t ui = 0; ui < u; ++ui) {
+					for (uint32_t vi = 0; vi < v; ++vi) {
+						uint32_t m = S::eq(S::popcnt(S::xor_(li[ui], r[vi])), wv);
+						while (m) {
+							const uint32_t b = cryptanalysislib::countr_zero(m);
+							if (add(i + ui, j + 8u*vi + b)) { return ctr; }
+							m &= m - 1u;
+						}
+					}
+				}
+			}
+
+			// tail of the right list
+			for (uint32_t ui = 0; ui < u; ++ui) {
+				for (size_t jj = j; jj < er; ++jj) {
+					if (scalar(i + ui, jj)) { return ctr; }
+				}
+			}
+		}
+
+		// tail of the left list
+		for (; i < el; ++i) {
+			for (size_t j = 0; j < er; ++j) {
+				if (scalar(i, j)) { return ctr; }
+			}
+		}
+
+		return ctr;
+	}
