diff --git a/tests/algorithm/pext.cpp b/tests/algorithm/pext.cpp
new file mode 100644
index 0000000..ff76947
--- /dev/null
+++ b/tests/algorithm/pext.cpp
@@ -0,0 +1,76 @@
+#include <gtest/gtest.h>
+#include <cstdint>
+#include <vector>
+
+#include "random.h"
+
+using ::testing::InitGoogleTest;
+using ::testing::Test;
+using namespace cryptanalysislib;
+
+#if defined(USE_AVX2) && defined(USE_BMI2)
+#include "algorithm/bits/pext.h"
+
+/// portable reference: extracts the bits of `v` at the set bits of `m` into the low bits
+static uint32_t pext_ref(uint32_t v, uint32_t m) {
+	uint32_t ret = 0;
+	for (uint32_t i = 0, k = 0; i < 32; ++i) {
+		if ((m >> i) & 1u) { ret |= ((v >> i) & 1u) << k++; }
+	}
+	return ret;
+}
+
+/// masks with every popcount 0..32, plus random ones
+static void gen(std::vector<uint32_t> &data, std::vector<uint32_t> &mask, const size_t n) {
+	data.resize(n); mask.resize(n);
+	for (size_t i = 0; i < n; ++i) {
+		data[i] = rng<uint32_t>();
+		uint32_t m = 0;
+		const uint32_t w = i % 33;
+		while ((uint32_t)__builtin_popcount(m) < w) { m |= 1u << (rng<uint32_t>() % 32u); }
+		mask[i] = (i & 1) ? m : rng<uint32_t>();
+	}
+}
+
+TEST(pext, reference_vs_bmi2) {
+	std::vector<uint32_t> d, m; gen(d, m, 4096);
+	for (size_t i = 0; i < d.size(); ++i) {
+		EXPECT_EQ(pext_ref(d[i], m[i]), _pext_u32(d[i], m[i])) << i;
+	}
+}
+
+TEST(pext, emu) {
+	std::vector<uint32_t> d, m; gen(d, m, 4096);
+	for (size_t i = 0; i < d.size(); ++i) {
+		EXPECT_EQ(pext32_emu(d[i], m[i]), pext_ref(d[i], m[i])) << std::hex << d[i] << " " << m[i];
+	}
+}
+
+template<const bool early_exit>
+static void check_avx2() {
+	constexpr size_t n = 4096; // multiple of 8, the functions have no tail handling
+	std::vector<uint32_t> d, m, out(n); gen(d, m, n);
+	avx2_pext_u32_reference<32, early_exit>(d.data(), m.data(), out.data(), n);
+	for (size_t i = 0; i < n; ++i) { EXPECT_EQ(out[i], pext_ref(d[i], m[i])) << i; }
+}
+TEST(pext, avx2) { check_avx2<false>(); }
+TEST(pext, avx2_early_exit) { check_avx2<true>(); }
+
+#ifdef USE_AVX512F
+template<const bool early_exit>
+static void check_avx512() {
+	constexpr size_t n = 4096; // multiple of 16
+	std::vector<uint32_t> d, m, out(n); gen(d, m, n);
+	avx512_pext_u32_reference<32, early_exit>(d.data(), m.data(), out.data(), n);
+	for (size_t i = 0; i < n; ++i) { EXPECT_EQ(out[i], pext_ref(d[i], m[i])) << i; }
+}
+TEST(pext, avx512) { check_avx512<false>(); }
+TEST(pext, avx512_early_exit) { check_avx512<true>(); }
+#endif
+#endif
+
+int main(int argc, char **argv) {
+	InitGoogleTest(&argc, argv);
+	rng_seed(time(NULL));
+	return RUN_ALL_TESTS();
+}
diff --git a/bench/algorithm/pext.cpp b/bench/algorithm/pext.cpp
new file mode 100644
index 0000000..4b91bae
--- /dev/null
+++ b/bench/algorithm/pext.cpp
@@ -0,0 +1,70 @@
+#include <benchmark/benchmark.h>
+#include <cstdint>
+#include <vector>
+
+#include "random.h"
+
+using namespace cryptanalysislib;
+constexpr size_t LS = 1u << 12u; // multiple of 16: the SIMD versions have no tail handling
+
+#if defined(USE_AVX2) && defined(USE_BMI2)
+#include "algorithm/bits/pext.h"
+
+static std::vector<uint32_t> data, mask, out;
+
+/// `bits` = popcount of every mask
+static void generate(const uint32_t bits) {
+	data.resize(LS); mask.resize(LS); out.resize(LS);
+	for (size_t i = 0; i < LS; ++i) {
+		data[i] = rng<uint32_t>();
+		uint32_t m = 0;
+		while ((uint32_t)__builtin_popcount(m) < bits) { m |= 1u << (rng<uint32_t>() % 32u); }
+		mask[i] = m;
+	}
+}
+
+static void BM_pext_bmi2(benchmark::State &state) {
+	generate(state.range(0));
+	for (auto _: state) {
+		for (size_t i = 0; i < LS; ++i) { out[i] = _pext_u32(data[i], mask[i]); }
+		benchmark::ClobberMemory();
+	}
+}
+
+static void BM_pext_emu(benchmark::State &state) {
+	generate(state.range(0));
+	for (auto _: state) {
+		for (size_t i = 0; i < LS; ++i) { out[i] = pext32_emu(data[i], mask[i]); }
+		benchmark::ClobberMemory();
+	}
+}
+
+template<const bool early_exit>
+static void BM_pext_avx2(benchmark::State &state) {
+	generate(state.range(0));
+	for (auto _: state) {
+		avx2_pext_u32_reference<32, early_exit>(data.data(), mask.data(), out.data(), LS);
+		benchmark::ClobberMemory();
+	}
+}
+
+BENCHMARK(BM_pext_bmi2)->DenseRange(0, 32, 8);
+BENCHMARK(BM_pext_emu)->DenseRange(0, 32, 8);
+BENCHMARK(BM_pext_avx2<false>)->DenseRange(0, 32, 8);
+BENCHMARK(BM_pext_avx2<true>)->DenseRange(0, 32, 8);
+
+#ifdef USE_AVX512F
+template<const bool early_exit>
+static void BM_pext_avx512(benchmark::State &state) {
+	generate(state.range(0));
+	for (auto _: state) {
+		avx512_pext_u32_reference<32, early_exit>(data.data(), mask.data(), out.data(), LS);
+		benchmark::ClobberMemory();
+	}
+}
+BENCHMARK(BM_pext_avx512<false>)->DenseRange(0, 32, 8);
+BENCHMARK(BM_pext_avx512<true>)->DenseRange(0, 32, 8);
+#endif
+#endif
+
+BENCHMARK_MAIN();
