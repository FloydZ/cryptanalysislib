diff --git a/tests/container/binary_packed_vector_ranges.cpp b/tests/container/binary_packed_vector_ranges.cpp
new file mode 100644
index 0000000..ef0369d
--- /dev/null
+++ b/tests/container/binary_packed_vector_ranges.cpp
@@ -0,0 +1,26 @@
+#include <gtest/gtest.h>
+#include "container/binary_packed_vector.h"
+#include "random.h"
+
+using ::testing::InitGoogleTest;
+/// add/mul on bit ranges [l, h) against bitwise reference, long vectors so the SIMD loop runs
+template<uint32_t n, typename T> void check() {
+	using V = FqPackedVector<n, 2, T>;
+	for (uint32_t r = 0; r < 300; ++r) {
+		V a, b, c, d; a.random(); b.random(); c.random(); d = c;
+		const uint32_t l = cryptanalysislib::rng() % (n - 1), h = l + 1 + cryptanalysislib::rng() % (n - l - 1) + 1 > n ? n : l + 1 + cryptanalysislib::rng() % (n - l);
+		V::add(c, a, b, l, h);
+		for (uint32_t k = 0; k < n; ++k) {
+			const bool e = (k >= l && k < h) ? (a.get_bit_shifted(k) ^ b.get_bit_shifted(k)) : d.get_bit_shifted(k);
+			ASSERT_EQ(c.get_bit_shifted(k), e) << l << " " << h << " " << k;
+		}
+		c = d;
+		V::mul(c, a, b, l, h);
+		for (uint32_t k = 0; k < n; ++k) {
+			const bool e = (k >= l && k < h) ? (a.get_bit_shifted(k) & b.get_bit_shifted(k)) : d.get_bit_shifted(k);
+			ASSERT_EQ(c.get_bit_shifted(k), e) << "mul " << l << " " << h << " " << k;
+		}
+	}
+}
+TEST(bv, ranges) { check<2048, uint64_t>(); check<1000, uint64_t>(); check<777, uint32_t>(); }
+int main(int argc, char **argv) { ::testing::InitGoogleTest(&argc, argv); cryptanalysislib::rng_seed(time(NULL)); return RUN_ALL_TESTS(); }
