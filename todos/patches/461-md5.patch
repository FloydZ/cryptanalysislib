+/// the pointer and the string_view interface agree, for lengths around
+/// the block boundaries (55, 56, 63, 64, ...)
+TEST(MD5, pointer_vs_string) {
+	std::string s;
+	for (uint32_t n = 0; n < 200; ++n) {
+		EXPECT_EQ(md5(s), md5((const uint8_t *)s.data(), s.size()));
+		s += char('a' + (n % 26));
+	}
