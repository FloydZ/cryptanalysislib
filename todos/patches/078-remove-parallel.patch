@@ -59,4 +62,68 @@ namespace cryptanalysislib {
         }
         return d_first;
     }
+
+    /// Configuration for the parallel remove algorithms
+    struct AlgorithmRemoveConfig : public AlgorithmConfig {
+        constexpr static size_t min_size_per_thread = 1u << 15u;
+    };
+    constexpr static AlgorithmRemoveConfig algorithmRemoveConfig;
+
+    /// stable `remove_if` (parallel version): every chunk is compacted
+    /// inplace in parallel (this is where `p` is evaluated), then the
+    /// compacted chunks are moved together, in order.
+    /// NOTE: the moves are sequential: moving the chunks in parallel is not
+    ///     safe, as a destination can overlap the source of an earlier chunk.
+    /// \return iterator to the new end of the range
+    template<class ExecPolicy,
+             class RandIt,
+             class UnaryPred,
+             const AlgorithmRemoveConfig &config = algorithmRemoveConfig>
+#if __cplusplus > 201709L
+    requires std::random_access_iterator<RandIt>
+#endif
+    RandIt remove_if(ExecPolicy &&policy,
+                     RandIt first,
+                     RandIt last,
+                     UnaryPred p) noexcept {
+        const size_t n = static_cast<size_t>(std::distance(first, last));
+        const uint32_t nthreads = should_par(policy, config, n);
+        if (is_seq<ExecPolicy>(policy) || nthreads < 2) {
+            return cryptanalysislib::remove_if(first, last, p);
+        }
+
+        auto &task_pool = *policy.pool();
+        std::vector<std::future<RandIt>> futures;
+        for (uint32_t k = 0; k < nthreads; ++k) {
+            const size_t lo = (n * k) / nthreads, hi = (n * (k + 1)) / nthreads;
+            futures.emplace_back(task_pool.submit([first, lo, hi, &p]() {
+                return cryptanalysislib::remove_if(first + lo, first + hi, p);
+            }));
+        }
+
+        RandIt out = futures[0].get();
+        for (uint32_t k = 1; k < nthreads; ++k) {
+            const size_t lo = (n * k) / nthreads;
+            const RandIt end = futures[k].get();
+            out = std::move(first + lo, end, out);
+        }
+        return out;
+    }
+
+    /// stable `remove` (parallel version), see the parallel `remove_if`
+    /// \return iterator to the new end of the range
+    template<class ExecPolicy,
+             class RandIt,
+             class T = typename std::iterator_traits<RandIt>::value_type,
+             const AlgorithmRemoveConfig &config = algorithmRemoveConfig>
+#if __cplusplus > 201709L
+    requires std::random_access_iterator<RandIt>
+#endif
+    RandIt remove(ExecPolicy &&policy,
+                  RandIt first,
+                  RandIt last,
+                  const T &value) noexcept {
+        return cryptanalysislib::remove_if(std::forward<ExecPolicy>(policy), first, last,
+                                           [&value](const auto &x) { return x == value; });
+    }
 }; // end namespace cryptanalysislib
diff --git a/tests/algorithm/remove.cpp b/tests/algorithm/remove.cpp
new file mode 100644
index 0000000..edfba42
--- /dev/null
+++ b/tests/algorithm/remove.cpp
@@ -0,0 +1,39 @@
+#include <gtest/gtest.h>
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+#include "random.h"
+#include "algorithm/remove.h"
+
+using ::testing::InitGoogleTest;
+using namespace cryptanalysislib;
+
+/// parallel remove/remove_if against std::: stability via (key, index) pairs
+TEST(remove, multithreading) {
+	constexpr size_t n = 1u << 21;
+	for (const uint32_t mod : {2u, 7u, 1000u}) {
+		std::vector<std::pair<uint32_t, uint32_t>> v(n);
+		for (size_t i = 0; i < n; ++i) { v[i] = {uint32_t(rng() % mod), uint32_t(i)}; }
+		auto e = v;
+		const auto p = [](const auto &x) { return x.first == 1u; };
+		const auto r = cryptanalysislib::remove_if(par_if(true), v.begin(), v.end(), p);
+		const auto re = std::remove_if(e.begin(), e.end(), p);
+		ASSERT_EQ(r - v.begin(), re - e.begin()) << mod;
+		EXPECT_TRUE(std::equal(v.begin(), r, e.begin())) << mod;
+	}
+
+	std::vector<uint32_t> w(n);
+	for (auto &x : w) { x = uint32_t(rng() % 4u); }
+	auto ew = w;
+	const auto r = cryptanalysislib::remove(par_if(true), w.begin(), w.end(), 3u);
+	const auto re = std::remove(ew.begin(), ew.end(), 3u);
+	ASSERT_EQ(r - w.begin(), re - ew.begin());
+	EXPECT_TRUE(std::equal(w.begin(), r, ew.begin()));
+}
+
+int main(int argc, char **argv) {
+	InitGoogleTest(&argc, argv);
+	rng_seed(time(NULL));
+	return RUN_ALL_TESTS();
+}
