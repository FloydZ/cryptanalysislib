+namespace cryptanalysislib::internal {
+	/// the x86 status flags of `cmp a, b` (i.e. of `b - a`) or, if `test`,
+	/// of `test a, b` (i.e. of `a & b`), computed in C++
+	struct cmov_flags { bool cf, zf, sf, of, pf; };
+
+	template<typename T, const bool test>
+	constexpr cmov_flags cmov_compute_flags(const T a, const T b) noexcept {
+		using U = std::make_unsigned_t<T>;
+		constexpr uint32_t bits = sizeof(T) * 8u;
+		const U ua = static_cast<U>(a), ub = static_cast<U>(b);
+		const U r = test ? U(ua & ub) : U(ub - ua);
+		cmov_flags f{};
+		f.cf = test ? false : (ub < ua);
+		f.zf = (r == 0);
+		f.sf = (r >> (bits - 1u)) & 1u;
+		f.of = test ? false : ((((ub ^ ua) & (ub ^ r)) >> (bits - 1u)) & 1u);
+		f.pf = (__builtin_popcount(uint32_t(r & 0xffu)) & 1u) == 0; // even parity of the low byte
+		return f;
 	}
