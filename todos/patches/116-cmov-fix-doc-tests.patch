+/// every condition, `cmp` and `test` flavour, against the C++ definition of
+/// the x86 flags (on x86-64 the runtime calls run the asm, the constexpr ones
+/// the C++ fallback)
+template<typename T, const bool test>
+static void check_cmov() {
+	using namespace cryptanalysislib::internal;
+	std::vector<T> vals = {T(0), T(1), T(2), T(-1), T(-2), T(0x7f), T(0x80), T(0xff),
+	                       std::numeric_limits<T>::max(), std::numeric_limits<T>::min(),
+	                       T(std::numeric_limits<T>::max() - 1), T(std::numeric_limits<T>::min() + 1)};
+	for (uint32_t i = 0; i < 200; ++i) { vals.push_back(T(rand() * 2654435761u)); }
+	for (const T a : vals) {
+		for (const T b : vals) {
+			const auto f = cmov_compute_flags<T, test>(a, b);
+#define CHECK_COND(v, cond) EXPECT_EQ((cmov##v<T, test>(a, b)), ((cond) ? b : a)) << #v << " " << int64_t(a) << " " << int64_t(b);
+			CHECK_COND(a, !f.cf && !f.zf) CHECK_COND(ae, !f.cf) CHECK_COND(b, f.cf) CHECK_COND(be, f.cf || f.zf)
+			CHECK_COND(c, f.cf) CHECK_COND(e, f.zf) CHECK_COND(g, !f.zf && (f.sf == f.of)) CHECK_COND(ge, f.sf == f.of)
+			CHECK_COND(l, f.sf != f.of) CHECK_COND(le, f.zf || (f.sf != f.of)) CHECK_COND(na, f.cf || f.zf)
+			CHECK_COND(nae, f.cf) CHECK_COND(nb, !f.cf) CHECK_COND(nc, !f.cf) CHECK_COND(ng, f.zf || (f.sf != f.of))
+			CHECK_COND(ne, !f.zf) CHECK_COND(nl, f.sf == f.of) CHECK_COND(nle, !f.zf && (f.sf == f.of))
+			CHECK_COND(no, !f.of) CHECK_COND(np, !f.pf) CHECK_COND(nz, !f.zf) CHECK_COND(ns, !f.sf)
+			CHECK_COND(o, f.of) CHECK_COND(p, f.pf) CHECK_COND(pe, f.pf) CHECK_COND(po, !f.pf)
+			CHECK_COND(s, f.sf) CHECK_COND(z, f.zf)
+#undef CHECK_COND
+		}
+	}
+}
+
+TEST(cmov, all_conditions) {
+	check_cmov<uint16_t, false>(); check_cmov<uint16_t, true>();
+	check_cmov<int32_t, false>(); check_cmov<uint32_t, true>();
+	check_cmov<uint64_t, false>(); check_cmov<int64_t, true>();
+	check_cmov<uint8_t, false>(); // no 8 bit cmov: C++ path
+
+	// semantics of the documented examples, incl. constexpr evaluation
+	EXPECT_EQ(cmova<uint32_t>(5, 3), 5u);   // 3 > 5? no
+	EXPECT_EQ(cmova<uint32_t>(3, 5), 5u);   // max
+	EXPECT_EQ(cmovl<int32_t>(3, -5), -5);   // -5 < 3 (signed)
+	EXPECT_EQ(cmovb<uint32_t>(3, uint32_t(-5)), 3u); // unsigned: not below
+	EXPECT_EQ((cmovz<uint32_t, true>(0b1010, 0b0101)), 0b0101u);
+	static_assert(cmova<uint32_t>(3, 5) == 5u && cmovl<int32_t>(3, -5) == -5);
+}
