+/// the generic operators, for all AVX-512 types (also the signed ones)
+template<typename S>
+static void check_operators() {
+	using T = typename S::limb_type;
+	constexpr uint32_t N = S::LIMBS;
+	constexpr uint64_t full = (N >= 64) ? ~0ull : ((1ull << N) - 1ull);
+	alignas(64) T a[N], b[N], o[N];
+	for (uint32_t r = 0; r < 100; ++r) {
+		for (uint32_t i = 0; i < N; ++i) { a[i] = T(rng()); b[i] = (i % 3u) ? T(rng()) : a[i]; }
+		const S va = S::load(a), vb = S::load(b);
+		const T k = T(rng());
+		S::store(o, va + vb); for (uint32_t i = 0; i < N; ++i) { EXPECT_EQ(o[i], T(a[i] + b[i])); }
+		S::store(o, va - vb); for (uint32_t i = 0; i < N; ++i) { EXPECT_EQ(o[i], T(a[i] - b[i])); }
+		S::store(o, va * vb); for (uint32_t i = 0; i < N; ++i) { EXPECT_EQ(o[i], T(a[i] * b[i])); }
+		S::store(o, va * k);  for (uint32_t i = 0; i < N; ++i) { EXPECT_EQ(o[i], T(a[i] * k)); }
+		S::store(o, k * va);  for (uint32_t i = 0; i < N; ++i) { EXPECT_EQ(o[i], T(a[i] * k)); }
+		S::store(o, va ^ vb); for (uint32_t i = 0; i < N; ++i) { EXPECT_EQ(o[i], T(a[i] ^ b[i])); }
+		S::store(o, va & vb); for (uint32_t i = 0; i < N; ++i) { EXPECT_EQ(o[i], T(a[i] & b[i])); }
+		S::store(o, va | vb); for (uint32_t i = 0; i < N; ++i) { EXPECT_EQ(o[i], T(a[i] | b[i])); }
+		S::store(o, ~va);     for (uint32_t i = 0; i < N; ++i) { EXPECT_EQ(o[i], T(~a[i])); }
+		S c = va; c ^= vb; S::store(o, c); for (uint32_t i = 0; i < N; ++i) { EXPECT_EQ(o[i], T(a[i] ^ b[i])); }
+
+		uint64_t eq = 0, lt = 0, gt = 0;
+		for (uint32_t i = 0; i < N; ++i) {
+			eq |= uint64_t(a[i] == b[i]) << i;
+			lt |= uint64_t(a[i] < b[i]) << i;
+			gt |= uint64_t(a[i] > b[i]) << i;
+		}
+		EXPECT_EQ(va == vb, eq);
+		EXPECT_EQ(va != vb, full ^ eq);
+		EXPECT_EQ(va < vb, lt);
+		EXPECT_EQ(va > vb, gt);
+	}
+}
