+TEST(SortingNetwork, uint8x32_desc) {
+	alignas(32) uint8_t data[32];
+	for (uint32_t r = 0; r < 10000; ++r) {
+		for (uint32_t i = 0; i < 32; ++i) { data[i] = (r & 1u) ? (rng() % 3u) : rng(); }
+		const __m256i v = sortingnetwork_sort_u8x32_desc(_mm256_load_si256((const __m256i *)data));
+		alignas(32) uint8_t out[32];
+		_mm256_store_si256((__m256i *)out, v);
+		std::sort(data, data + 32, std::greater<>{});
+		ASSERT_EQ(memcmp(out, data, 32), 0);
+	}
+}
+
+TEST(SortingNetwork, uint8x288_stress) {
+	alignas(32) uint8_t data[288], expected[288];
+	for (uint32_t r = 0; r < 5000; ++r) {
+		for (uint32_t i = 0; i < 288; ++i) { data[i] = (r & 1u) ? (rng() % 3u) : rng(); }
+		memcpy(expected, data, 288);
+		std::sort(expected, expected + 288);
+		__m256i v[9];
+		for (uint32_t i = 0; i < 9; ++i) { v[i] = _mm256_load_si256((const __m256i *)(data + 32 * i)); }
+		sortingnetwork_sort_u8x288(v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8]);
+		for (uint32_t i = 0; i < 9; ++i) { _mm256_store_si256((__m256i *)(data + 32 * i), v[i]); }
+		ASSERT_EQ(memcmp(data, expected, 288), 0) << r;
+	}
+}
