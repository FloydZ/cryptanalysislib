+	/// \return number of keys < x
+	[[nodiscard]] constexpr size_t rank(const T &x) const noexcept {
+		size_t r = 0;
+		const node *t = root;
+		while (t) {
+			if (t->x < x) {
+				r += tsize(t->l) + 1;
+				t = t->r;
+			} else {
+				t = t->l;
+			}
+		}
+		return r;
 	}
