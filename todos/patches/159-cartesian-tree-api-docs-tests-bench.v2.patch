+	[[nodiscard]] constexpr const T &kth(size_t k) const noexcept {
+		const node *t = root;
+		while (true) {
+			const size_t ls = tsize(t->l);
+			if (k < ls) {
+				t = t->l;
+			} else if (k == ls) {
+				return t->x;
+			} else {
+				k -= ls + 1;
+				t = t->r;
+			}
+		}
+	}
