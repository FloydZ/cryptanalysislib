diff --git a/tests/algorithm/remove.cpp b/tests/algorithm/remove.cpp
new file mode 100644
index 0000000..986013b
--- /dev/null
+++ b/tests/algorithm/remove.cpp
@@ -0,0 +1,58 @@
+#include <gtest/gtest.h>
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+#include "random.h"
+#include "algorithm/remove.h"
+#include "algorithm/remove.h" // include guard
+
+using ::testing::InitGoogleTest;
+using namespace cryptanalysislib;
+
+/// remove against std::remove: all sizes around the SIMD block size, few
+/// distinct values (many removals, also whole blocks), the result prefix and
+/// the returned end must match
+template<typename T>
+static void check_remove(const size_t n, const uint32_t mod) {
+	std::vector<T> v(n);
+	for (auto &x : v) { x = T(rng() % mod); }
+	auto e = v;
+	const auto r = cryptanalysislib::remove(v.begin(), v.end(), T(1));
+	const auto re = std::remove(e.begin(), e.end(), T(1));
+	ASSERT_EQ(r - v.begin(), re - e.begin()) << n << " " << mod;
+	EXPECT_TRUE(std::equal(v.begin(), r, e.begin())) << n << " " << mod;
+}
+
+TEST(remove, uint32) {
+	for (size_t n = 0; n <= 300; ++n) {
+		check_remove<uint32_t>(n, 2);
+		check_remove<uint32_t>(n, 5);
+		check_remove<uint32_t>(n, 1u << 20);
+	}
+	check_remove<uint32_t>(1u << 20, 3);
+}
+
+TEST(remove, other_types) {
+	for (size_t n = 0; n <= 100; ++n) {
+		check_remove<uint8_t>(n, 3);
+		check_remove<uint64_t>(n, 3);
+	}
+}
+
+TEST(remove, remove_if) {
+	std::vector<uint32_t> v(1000);
+	for (auto &x : v) { x = uint32_t(rng() % 10u); }
+	auto e = v;
+	const auto p = [](const uint32_t x) { return x < 4u; };
+	const auto r = cryptanalysislib::remove_if(v.begin(), v.end(), p);
+	const auto re = std::remove_if(e.begin(), e.end(), p);
+	ASSERT_EQ(r - v.begin(), re - e.begin());
+	EXPECT_TRUE(std::equal(v.begin(), r, e.begin()));
+}
+
+int main(int argc, char **argv) {
+	InitGoogleTest(&argc, argv);
+	rng_seed(time(NULL));
+	return RUN_ALL_TESTS();
+}
diff --git a/bench/algorithm/remove.cpp b/bench/algorithm/remove.cpp
new file mode 100644
index 0000000..82d2302
--- /dev/null
+++ b/bench/algorithm/remove.cpp
@@ -0,0 +1,38 @@
+#include <benchmark/benchmark.h>
+#include <algorithm>
+#include <vector>
+
+#include "random.h"
+#include "algorithm/remove.h"
+
+using namespace cryptanalysislib;
+constexpr size_t LS = 1u << 22u;
+
+/// 25% of the elements are removed
+static std::vector<uint32_t> data, work;
+static void generate(const size_t n) {
+	data.resize(n); work.resize(n);
+	for (auto &x : data) { x = rng<uint32_t>() % 4u; }
+}
+
+static void BM_std_remove(benchmark::State &state) {
+	generate(state.range(0));
+	for (auto _: state) {
+		work = data;
+		auto r = std::remove(work.begin(), work.end(), 1u);
+		benchmark::DoNotOptimize(r);
+	}
+}
+
+static void BM_remove(benchmark::State &state) {
+	generate(state.range(0));
+	for (auto _: state) {
+		work = data;
+		auto r = cryptanalysislib::remove(work.begin(), work.end(), 1u);
+		benchmark::DoNotOptimize(r);
+	}
+}
+
+BENCHMARK(BM_std_remove)->RangeMultiplier(16)->Range(1024, LS);
+BENCHMARK(BM_remove)->RangeMultiplier(16)->Range(1024, LS);
+BENCHMARK_MAIN();
