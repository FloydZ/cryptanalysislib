+/// C string keys, with the `critbit_cstr_*` key functors
+struct CStrRef { const char *k; };
+struct CStrHash {
+	const char *const *operator()(const CStrRef *r) const noexcept { return &r->k; }
+};
+
+TEST(critbit, cstr_keys) {
+	using Tree = critbit_tree<CStrRef, const char *, CStrHash,
+	                          critbit_cstr_keycmp, critbit_cstr_keylen, critbit_cstr_keybinary>;
+	Tree tree{};
+	std::set<std::string> e;
+	std::vector<std::unique_ptr<std::string>> storage;
+	std::vector<std::unique_ptr<CStrRef>> refs;
+	for (size_t i = 0; i < 2000; ++i) {
+		auto s = std::make_unique<std::string>();
+		const size_t len = 1 + rand() % 5;
+		for (size_t j = 0; j < len; ++j) { s->push_back(char('a' + rand() % 3)); }
+		auto r = std::make_unique<CStrRef>(CStrRef{s->c_str()});
+		auto *node = (Tree::critbit_node *)calloc(1, sizeof(Tree::critbit_node));
+		const bool inserted = tree.critbit_insert_impl(node, r.get()) == nullptr;
+		EXPECT_EQ(inserted, e.insert(*s).second) << *s;
+		if (inserted) { storage.push_back(std::move(s)); refs.push_back(std::move(r)); }
+	}
+
+	for (const auto &r : refs) {
+		const CStrRef *f = tree.critbit_get_impl(&r->k);
+		ASSERT_NE(f, nullptr);
+		EXPECT_EQ(f, r.get());
+	}
+	const char *missing = "dddd";
+	EXPECT_EQ(tree.critbit_get_impl(&missing), nullptr);
+	for (const auto &r : refs) {
+		EXPECT_NE(tree.critbit_remove_impl(&r->k), nullptr);
+		EXPECT_EQ(tree.critbit_get_impl(&r->k), nullptr);
+	}
+}
+
+/// fixed size binary keys (also with zero bytes), with the `critbit_buf_*` key functors
+using Buf = std::array<uint8_t, 4>;
+struct BufRef { Buf k; };
+struct BufHash {
+	const Buf *operator()(const BufRef *r) const noexcept { return &r->k; }
+};
+
+TEST(critbit, buf_keys) {
+	using Tree = critbit_tree<BufRef, Buf, BufHash,
+	                          critbit_buf_keycmp<4>, critbit_buf_keylen<4>, critbit_buf_keybinary>;
+	Tree tree{};
+	std::set<Buf> e;
+	std::vector<std::unique_ptr<BufRef>> refs;
+	for (size_t i = 0; i < 3000; ++i) {
+		auto r = std::make_unique<BufRef>();
+		// small alphabet: many zero bytes and common prefixes
+		for (auto &b : r->k) { b = uint8_t(rand() % 3); }
+		auto *node = (Tree::critbit_node *)calloc(1, sizeof(Tree::critbit_node));
+		const bool inserted = tree.critbit_insert_impl(node, r.get()) == nullptr;
+		EXPECT_EQ(inserted, e.insert(r->k).second);
+		if (inserted) { refs.push_back(std::move(r)); }
+	}
+
+	EXPECT_EQ(refs.size(), e.size());
+	for (const auto &r : refs) {
+		const BufRef *f = tree.critbit_get_impl(&r->k);
+		ASSERT_NE(f, nullptr);
+		EXPECT_EQ(f, r.get());
+	}
+	for (size_t i = 0; i < refs.size(); i += 2) {
+		EXPECT_NE(tree.critbit_remove_impl(&refs[i]->k), nullptr);
+	}
+	for (size_t i = 0; i < refs.size(); ++i) {
+		EXPECT_EQ(tree.critbit_get_impl(&refs[i]->k) != nullptr, (i & 1u) == 1u);
+	}
+}
