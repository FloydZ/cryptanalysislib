+/// bit_floor against std::bit_floor
+TEST(count_zero, bit_floor) {
+	for (uint32_t i = 0; i < 256; ++i) {
+		EXPECT_EQ(cryptanalysislib::bit_floor(uint8_t(i)), std::bit_floor(uint8_t(i))) << i;
+	}
+	for (uint32_t i = 0; i < 10000; ++i) {
+		const uint64_t x = rng() >> (rng() % 64);
+		EXPECT_EQ(cryptanalysislib::bit_floor(x), std::bit_floor(x)) << x;
+		EXPECT_EQ(cryptanalysislib::bit_floor(uint32_t(x)), std::bit_floor(uint32_t(x))) << x;
+	}
+	using T = unsigned __int128;
+	EXPECT_EQ(cryptanalysislib::bit_floor(T(0)), T(0));
+	EXPECT_EQ(cryptanalysislib::bit_floor(T(3) << 100u), T(1) << 101u);
+}
