+TEST(BinaryMatrix, mul) {
+	constexpr_for<1u, 140u, size_step>([](const auto nr) {
+		constexpr_for<1u, 140u, size_step>([nr](const auto nc) {
+			constexpr_for<1u, 140u, size_step>([nr, nc](const auto np) {
+				using A = FqMatrix<T, nr, nc, 2>;
+				using B = FqMatrix<T, nc, np, 2>;
+				using BT = FqMatrix<T, np, nc, 2>;
+				using C = FqMatrix<T, nr, np, 2>;
+				A a; B b; C c, c2;
+				fill_random(a);
+				fill_random(b);
+				fill_random(c);
+				A::template mul<np>(c, a, b);
+				for (uint32_t i = 0; i < nr; ++i) {
+					for (uint32_t j = 0; j < np; ++j) {
+						bool s = 0;
+						for (uint32_t k = 0; k < nc; ++k) {
+							s ^= a.get(i, k) & b.get(k, j);
+						}
+						EXPECT_EQ(c.get(i, j), s);
+					}
+				}
+
+				const BT bt = b.transpose();
+				A::template mul_transposed<np>(c2, a, bt);
+				EXPECT_TRUE(C::is_equal(c, c2));
+			});
+		});
+	});
+}
