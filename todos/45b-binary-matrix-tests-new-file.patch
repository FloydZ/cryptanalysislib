+TEST(BinaryMatrix, markov_gaus) {
+	for_sizes([](const auto nr, const auto nc) {
+		constexpr uint32_t l = 10, c = 5;
+		if constexpr ((nr > l + c) && (nr < nc)) {
+			using M = FqMatrix<T, nr, nc, 2>;
+			M m;
+			Permutation P(nc);
+			uint32_t rank = 0;
+			while (true) {
+				random_full_rank(m);
+				rank = m.gaus(nr - l);
+				if (rank >= nr - l) { break; }
+			}
+
+			for (uint32_t k = 0; k < 10; ++k) {
+				const uint32_t rank2 = m.template markov_gaus<c, nr - l>(P);
+				EXPECT_EQ(rank, rank2);
+				for (uint32_t i = 0; i < nr; ++i) {
+					for (uint32_t j = 0; j < nr - l; ++j) {
+						EXPECT_EQ(m.get(i, j), i == j);
+					}
+				}
+			}
+		}
+	});
+}
