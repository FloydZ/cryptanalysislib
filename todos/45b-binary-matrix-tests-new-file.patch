+TEST(BinaryMatrix, permute_cols) {
+	for_sizes([](const auto nr, const auto nc) {
+		using M = FqMatrix<T, nr, nc, 2>;
+		using MT = FqMatrix<T, nc, nr, 2>;
+		M m;
+		MT mt;
+		fill_random(m);
+		const M orig = m;
+		Permutation P(nc);
+		m.permute_cols(mt, P);
+		for (uint32_t i = 0; i < nr; ++i) {
+			for (uint32_t j = 0; j < nc; ++j) {
+				EXPECT_EQ(m.get(i, j), orig.get(i, P.values[j]));
+			}
+		}
+	});
+}
+
+TEST(BinaryMatrix, from_string) {
+	using M = FqMatrix<T, 2, 3, 2>;
+	const M m{"011100"};
+	EXPECT_EQ(m.get(0, 0), 0); EXPECT_EQ(m.get(0, 1), 1); EXPECT_EQ(m.get(0, 2), 1);
+	EXPECT_EQ(m.get(1, 0), 1); EXPECT_EQ(m.get(1, 1), 0); EXPECT_EQ(m.get(1, 2), 0);
+}
+
+int main(int argc, char **argv) {
+	InitGoogleTest(&argc, argv);
+	rng_seed(time(nullptr));
+	return RUN_ALL_TESTS();
+}
