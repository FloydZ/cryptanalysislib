+TEST(BinaryMatrix, gaus) {
+	for_sizes([](const auto nr, const auto nc) {
+		if constexpr (nr <= nc) {
+			using M = FqMatrix<T, nr, nc, 2>;
+			for (uint32_t k = 0; k < 5; ++k) {
+				M m;
+				random_full_rank(m);
+				const M orig = m;
+				const uint32_t rank = (k & 1u) ? m.gaus() : m.m4ri();
+				EXPECT_EQ(rank, nr);
+				for (uint32_t i = 0; i < nr; ++i) {
+					for (uint32_t j = 0; j < nr; ++j) {
+						EXPECT_EQ(m.get(i, j), i == j);
+					}
+				}
+				EXPECT_TRUE(padding_is_zero(m));
+				expect_row_equivalent(orig, m);
+			}
+
+			// uniform random matrices: the first `rank` columns are systemized
+			M m;
+			fill_random(m);
+			const uint32_t rank = m.gaus();
+			for (uint32_t i = 0; i < nr; ++i) {
+				for (uint32_t j = 0; j < rank; ++j) {
+					EXPECT_EQ(m.get(i, j), i == j);
+				}
+			}
+		}
+	});
+}
+
+TEST(BinaryMatrix, fix_gaus) {
+	for_sizes([](const auto nr, const auto nc) {
+		if constexpr ((nr > 3) && (nr < nc)) {
+			using M = FqMatrix<T, nr, nc, 2>;
+			M m;
+			// full rank, but column 3 is zero: gaus stops there
+			random_full_rank(m);
+			for (uint32_t i = 0; i < nr; ++i) { m.set(0, i, nc - 1u); }
+			m.swap_cols(3, nc - 1u);
+			const M orig = m;
+
+			Permutation P{nc};
+			const uint32_t rank = m.gaus();
+			EXPECT_EQ(rank, 3u);
+			const uint32_t rank2 = m.fix_gaus(P, rank, nr);
+			EXPECT_EQ(rank2, nr);
+			for (uint32_t i = 0; i < nr; ++i) {
+				for (uint32_t j = 0; j < nr; ++j) {
+					EXPECT_EQ(m.get(i, j), i == j);
+				}
+			}
+
+			// the systemized matrix spans the row space of the permuted input
+			M origP;
+			for (uint32_t i = 0; i < nr; ++i) {
+				for (uint32_t j = 0; j < nc; ++j) {
+					origP.set(orig.get(i, P.values[j]), i, j);
+				}
+			}
+			expect_row_equivalent(origP, m);
+		}
+	});
+}
