+/// non default allocator
+TEST(BTreeSet, allocator) {
+	BTreeSet<long, std::pmr::polymorphic_allocator<long>> b(3);
+	std::set<long> e;
+	for (int i = 0; i < 5000; ++i) {
+		const long v = long(randGen() % 3000);
+		if (randGen() % 4) { b.insert(v); e.insert(v); } else { b.erase(v); e.erase(v); }
+	}
+
+	EXPECT_EQ(b.size(), e.size());
+	std::vector<long> got(b.begin(), b.end());
+	EXPECT_EQ(got, std::vector<long>(e.begin(), e.end()));
+
+	BTreeSet<long, std::pmr::polymorphic_allocator<long>> c(b);
+	EXPECT_EQ(std::vector<long>(c.begin(), c.end()), got);
+}
