+#ifdef USE_AVX2
+/// sum of all lanes (mod 2^32), also in a constant expression
+TEST(reduce, reduce_add) {
+	for (uint32_t it = 0; it < 1000; ++it) {
+		uint32x8_t a;
+		uint32_t e = 0;
+		for (uint32_t i = 0; i < 8; ++i) { a[i] = rng<uint32_t>(); e += a[i]; }
+		EXPECT_EQ(uint32x8_t::reduce_add(a), e);
+#ifdef USE_AVX512F
+		uint32x16_t b;
+		e = 0;
+		for (uint32_t i = 0; i < 16; ++i) { b[i] = rng<uint32_t>(); e += b[i]; }
+		EXPECT_EQ(uint32x16_t::reduce_add(b), e);
+#endif
+	}
+	static_assert(uint32x8_t::reduce_add(uint32x8_t::set1(3)) == 24u);
+}
+#endif
