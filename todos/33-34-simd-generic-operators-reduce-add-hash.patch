index 8f66f64..f94b12f 100644
--- a/src/simd/avx2.h
+++ b/src/simd/avx2.h
@@ -4016,6 +4016,23 @@ struct Xint32x8_t {
 		return ret;
 	}
 
+	/// \param in
+	/// \return the sum of all lanes (mod 2^32)
+	[[nodiscard]] constexpr static inline limb_type reduce_add(const S in) noexcept {
+		if (std::is_constant_evaluated()) {
+			const V v = (V)in.v256;
+			uint32_t ret = 0;
+			for (uint32_t i = 0; i < LIMBS; ++i) { ret += uint32_t(v[i]); }
+			return limb_type(ret);
+		}
+
+		__m128i sum = _mm_add_epi32(_mm256_castsi256_si128(in.v256),
+		                            _mm256_extracti128_si256(in.v256, 1));
+		sum = _mm_add_epi32(sum, _mm_unpackhi_epi64(sum, sum));
+		sum = _mm_add_epi32(sum, _mm_shuffle_epi32(sum, _MM_SHUFFLE(2, 3, 0, 1)));
+		return limb_type(_mm_cvtsi128_si32(sum));
+	}
+
 	/// checks if all bytes are equal
 	/// \param in
 	/// \return
