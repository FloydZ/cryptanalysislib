--- a/tests/container/fq_packed_vector_v2.cpp
+++ b/tests/container/fq_packed_vector_v2.cpp
@@ -0,0 +1,69 @@
+#include <gtest/gtest.h>
+#include <cstdint>
+
+#include "container/fq_packed_vector_v2.h"
+#include "random.h"
+
+using ::testing::InitGoogleTest;
+using ::testing::Test;
+
+template<typename K>
+void test_access() {
+	K t;
+	for (uint32_t i = 0; i < K::length; ++i) {
+		t.set(i, i);
+	}
+	for (uint32_t i = 0; i < K::length; ++i) {
+		EXPECT_EQ(t.get(i), i % K::q);
+	}
+
+	for (uint32_t i = 0; i < K::length; ++i) {
+		t.set(0, i);
+	}
+	for (uint32_t i = 0; i < K::length; ++i) {
+		EXPECT_EQ(t.get(i), 0);
+	}
+}
+
+template<typename K, const uint32_t l, const uint32_t h>
+void test_hash() {
+	K t;
+	for (uint32_t i = 0; i < K::length; ++i) {
+		t.set(rng() % K::q, i);
+	}
+
+	uint64_t expected = 0;
+	for (uint32_t i = l; i < h; ++i) {
+		expected |= uint64_t(t.get(i)) << ((i - l) * K::bits_per_number);
+	}
+
+	EXPECT_EQ((t.template hash<l, h>()), expected);
+	EXPECT_EQ(t.hash(l, h), expected);
+}
+
+TEST(FqPackedVector_v2, access) {
+	test_access<FqPackedVectorMeta_v2<127, 3, uint8_t>>();
+	test_access<FqPackedVectorMeta_v2<127, 5, uint8_t>>();
+	test_access<FqPackedVectorMeta_v2<127, 7, uint32_t>>();
+	test_access<FqPackedVectorMeta_v2<100, 5, uint64_t>>();
+	test_access<FqPackedVectorMeta_v2<33, 1021, uint16_t>>();
+}
+
+TEST(FqPackedVector_v2, hash) {
+	for (uint32_t i = 0; i < 100; ++i) {
+		// 3 bits per number: numbers span two limbs
+		test_hash<FqPackedVectorMeta_v2<127, 5, uint8_t>, 0, 21>();
+		test_hash<FqPackedVectorMeta_v2<127, 5, uint8_t>, 7, 23>();
+		test_hash<FqPackedVectorMeta_v2<127, 5, uint64_t>, 20, 41>();
+		test_hash<FqPackedVectorMeta_v2<127, 5, uint64_t>, 106, 127>();
+		test_hash<FqPackedVectorMeta_v2<100, 7, uint32_t>, 3, 5>();
+		// 10 bits per number, wider than the limb
+		test_hash<FqPackedVectorMeta_v2<33, 1021, uint16_t>, 1, 7>();
+	}
+}
+
+int main(int argc, char **argv) {
+	InitGoogleTest(&argc, argv);
+	rng_seed(time(nullptr));
+	return RUN_ALL_TESTS();
+}
