+		RB_Tree<K, K> t;
+		std::set<K> ref;
+		for (uint32_t i = 0; i < 20000; ++i) {
+			const K k = rng<K>(range);
+			if (rng<uint32_t>(3) != 0) {
+				const auto [it, ins] = t.insert_unique(k);
+				const auto [rit, rins] = ref.insert(k);
+				EXPECT_EQ(ins, rins);
+				EXPECT_EQ(*it, *rit);
+			} else {
+				EXPECT_EQ(t.erase(k), ref.erase(k));
+			}
+
+			if ((i % 1000) == 0) { expect_same(t, ref); }
+		}
+		expect_same(t, ref);
