+		for (uint32_t i = 0; i < 1000; ++i) {
+			const K k = rng<K>(range + 2);
+			EXPECT_EQ(t.contains(k), ref.count(k) == 1);
+			EXPECT_EQ(t.count(k), ref.count(k));
+			const auto lb = t.lower_bound(k);
+			const auto rlb = ref.lower_bound(k);
+			EXPECT_EQ(lb == t.end(), rlb == ref.end());
+			if (rlb != ref.end()) { EXPECT_EQ(*lb, *rlb); }
+			const auto ub = t.upper_bound(k);
