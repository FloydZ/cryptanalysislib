+	[[nodiscard]] constexpr size_t check(const Node *n, const Node *p) const noexcept {
+		if (!n) { return 1; }
+		if (n->parent != p) { return 0; }
+		if (is_red(n) && (is_red(n->left) || is_red(n->right))) { return 0; }
