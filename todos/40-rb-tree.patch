+/// compares the tree with the reference container (same order)
+template<class Tree, class Ref>
+static void expect_same(const Tree &t, const Ref &ref) {
+	EXPECT_TRUE(t.check());
+	ASSERT_EQ(t.size(), ref.size());
+	EXPECT_EQ(t.empty(), ref.empty());
+	auto it = t.begin();
+	for (const auto &v : ref) {
+		ASSERT_NE(it, t.end());
+		EXPECT_EQ(*it, v);
+		++it;
+	}
+	EXPECT_EQ(it, t.end());
+
+	// backwards from end()
+	auto rit = t.end();
+	for (auto r = ref.rbegin(); r != ref.rend(); ++r) {
+		--rit;
+		EXPECT_EQ(*rit, *r);
+	}
+	EXPECT_EQ(rit, t.begin());
+}
