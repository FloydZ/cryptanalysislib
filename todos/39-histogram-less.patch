+/// histogram of values in [0, 128): `histogram[v] += #{i : ptr[i] == v}`
+/// NOTE: all values must be < 128, `histogram` has 128 entries
+/// The values are compressed into two buffers (0-63, 64-127), every 64 values
+/// of a buffer are counted with `consume`.
+static void histogram_less(uint32_t* histogram,
+                           const uint8_t* ptr,
+                           const size_t N) noexcept {
+	// at most 63 values remain after a flush, plus 64 new ones
+	uint8_t buffer[2][128] __attribute__((aligned(64)));
+	uint8_t hist8[64] __attribute__((aligned(64)));
+	uint32_t count[2] = {0, 0};
+
+	size_t i = 0;
+    for (; i + 64 <= N; i += 64) {
+        // Load 64 bytes, use bit 6 of each to choose the bin.
+        const __m512i data = _mm512_loadu_si512(ptr + i);
+        const __mmask64 b1 = _mm512_movepi8_mask(_mm512_add_epi8(data, data));  // Values 64-127
+    	const __mmask64 b0 = _knot_mask64(b1);  // Values 0-63
+
+        // Append into bins. NOTE: `consume` only counts values < 64
+        _mm512_storeu_epi8(buffer[0] + count[0], _mm512_maskz_compress_epi8(b0, data));
+        _mm512_storeu_epi8(buffer[1] + count[1],
+                           _mm512_maskz_compress_epi8(b1, _mm512_sub_epi8(data, _mm512_set1_epi8(64))));
+        count[0] += _mm_popcnt_u64(b0);
+        count[1] += _mm_popcnt_u64(b1);
+
+        for (uint32_t k = 0; k < 2; ++k) {
+            if (count[k] >= 64) {
+                consume(hist8, buffer[k], 64);
+                for (uint32_t j = 0; j < 64; ++j) { histogram[64*k + j] += hist8[j]; }
+                count[k] -= 64;
+                // NOTE: does not overlap, `count[k] < 64`
+                cryptanalysislib::memcpy(buffer[k], buffer[k] + 64, count[k]);
+            }
+        }
     }
 
-	consume(histogram+ 0, buffer0, count0);
-	consume(histogram+64, buffer1, count1);
+	// the remaining values in the buffers. NOTE: `0xff` is not counted
+	for (uint32_t k = 0; k < 2; ++k) {
+		cryptanalysislib::memset(buffer[k] + count[k], uint8_t(0xff), 64 - count[k]);
+		consume(hist8, buffer[k], count[k]);
+		for (uint32_t j = 0; j < 64; ++j) { histogram[64*k + j] += hist8[j]; }
+	}
+
+	for (; i < N; ++i) {
+		histogram[ptr[i]] += 1;
+	}
 }
 
