+/// `func1` with code between the loops, which is independent of them
+/// (only `e` is used, all indices < 1024)
+template<typename T>
+void func5(T *a, T *b, T *c, T *d, T *e, T *f, const size_t n) {
+	for (size_t i = 0; i < n; ++i) {
+		a[i] = b[i] + c[i];
+	}
+
+	e[0] = e[1] + e[2];
+	e[3] = e[18] * e[13];
+	e[4] = e[128] + e[678];
+	e[5] = e[897] - e[1023];
+
+	for (size_t i = 0; i < n; ++i) {
+		d[i] = a[i] * f[i] - b[i];
+	}
+
+	e[6] = e[0] + e[5];
+	e[7] = e[3] ^ e[4];
+
 	for (size_t i = 0; i < n; ++i) {
 		a[i] = a[i] - f[i] - d[i];
 	}
@@ -179,11 +203,43 @@ static void BM_Func4(benchmark::State &state) {
 	delete[] f;
 }
 
+static void BM_Func5(benchmark::State &state) {
+	const size_t n = state.range(0);
+	T *a = new T[n];
+	T *b = new T[n];
+	T *c = new T[n];
+	T *d = new T[n];
+	T *e = new T[n];
+	T *f = new T[n];
+
+	std::random_device rd{};
+	std::mt19937 gen{rd()};
+	std::uniform_int_distribution dist{1, 10'000};
+	auto generator = [&dist, &gen]() { return dist(gen); };
+
+	std::generate(a, a + n, generator);
+	std::generate(e, e + n, generator);
+
+	for (auto _: state) {
+		// This code gets timed
+		func5(a, b, c, d, e, f, state.range(0));
+		benchmark::DoNotOptimize(e[7]);
+	}
+
+	delete[] a;
+	delete[] b;
+	delete[] c;
+	delete[] d;
+	delete[] e;
+	delete[] f;
+}
