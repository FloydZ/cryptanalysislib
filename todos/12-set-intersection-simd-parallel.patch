+/// SIMD version (sorted, duplicate free uint32_t) against std::set_intersection
+TEST(set_intersection, simd_u32) {
+	for (const uint32_t mod : {40u, 300u, 2000u, 1u << 30u}) {
+		for (size_t n1 = 0; n1 <= 140; n1 += 7) {
+			for (size_t n2 = 0; n2 <= 140; n2 += 11) {
+				std::set<uint32_t> sa, sb;
+				while (sa.size() < std::min<size_t>(n1, mod)) { sa.insert(rng<uint32_t>() % mod); }
+				while (sb.size() < std::min<size_t>(n2, mod)) { sb.insert(rng<uint32_t>() % mod); }
+				const std::vector<uint32_t> a(sa.begin(), sa.end()), b(sb.begin(), sb.end());
+
+				std::vector<uint32_t> o(std::min(a.size(), b.size())), e;
+				std::set_intersection(a.begin(), a.end(), b.begin(), b.end(), std::back_inserter(e));
+				const uint32_t *r = cryptanalysislib::set_intersection_simd(a.data(), a.data() + a.size(),
+				                                                            b.data(), b.data() + b.size(), o.data());
+				ASSERT_EQ(size_t(r - o.data()), e.size()) << n1 << " " << n2 << " " << mod;
+				EXPECT_TRUE(std::equal(e.begin(), e.end(), o.begin())) << n1 << " " << n2 << " " << mod;
+			}
+		}
+	}
+}
+
+/// parallel version (with duplicates) against std::set_intersection
+TEST(set_intersection, parallel) {
+	constexpr size_t N = 1u << 16u;
+	for (const uint32_t mod : {7u, 1000u, 1u << 20u}) {
+		std::vector<uint32_t> a(N), b(N / 2), o(N), e(N);
+		for (auto &x : a) { x = rng<uint32_t>() % mod; }
+		for (auto &x : b) { x = rng<uint32_t>() % mod; }
+		std::sort(a.begin(), a.end());
+		std::sort(b.begin(), b.end());
+		const auto r1 = cryptanalysislib::set_intersection(par_if(true), a.begin(), a.end(), b.begin(), b.end(), o.begin());
+		const auto r2 = std::set_intersection(a.begin(), a.end(), b.begin(), b.end(), e.begin());
+		ASSERT_EQ(r1 - o.begin(), r2 - e.begin()) << mod;
+		EXPECT_TRUE(std::equal(o.begin(), r1, e.begin())) << mod;
+
+		std::vector<uint32_t> ra(a.rbegin(), a.rend()), rb(b.rbegin(), b.rend());
+		const auto r3 = cryptanalysislib::set_intersection(par_if(true), ra.begin(), ra.end(), rb.begin(), rb.end(), o.begin(), std::greater<>());
+		const auto r4 = std::set_intersection(ra.begin(), ra.end(), rb.begin(), rb.end(), e.begin(), std::greater<>());
+		ASSERT_EQ(r3 - o.begin(), r4 - e.begin()) << mod;
+		EXPECT_TRUE(std::equal(o.begin(), r3, e.begin())) << mod;
+	}
+}
