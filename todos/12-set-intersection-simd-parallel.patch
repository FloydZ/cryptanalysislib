+    /// SIMD version of `set_intersection` for sorted, DUPLICATE FREE ranges
+    /// of `uint32_t` (AVX2, AVX-512; otherwise a scalar merge). Blocks of
+    /// both ranges are compared lane wise against each other.
+    /// \param first1[in]: pointer to the beginning of the first range
+    /// \param last1[in]: pointer to the end of the first range
+    /// \param first2[in]: pointer to the beginning of the second range
+    /// \param last2[in]: pointer to the end of the second range
+    /// \param d_first[out]: output, must have space for min(n1, n2) elements
+    /// \return pointer to the end of the constructed range
+    static inline uint32_t *set_intersection_simd(const uint32_t *first1,
+                                                  const uint32_t *last1,
+                                                  const uint32_t *first2,
+                                                  const uint32_t *last2,
+                                                  uint32_t *d_first) noexcept {
+        return d_first + internal::intersect_u32_simd(first1, first2,
+                                                      size_t(last1 - first1),
+                                                      size_t(last2 - first2),
+                                                      d_first);
+    }
+
+    /// `set_intersection` (parallel version): the first range is split into
+    /// `nthreads` chunks (only between elements which are not equivalent),
+    /// the matching part of the second range is found by binary search. The
+    /// chunks are intersected in parallel into buffers, which are then
+    /// copied (in order) to `d_first`.
+    /// NOTE: same output as the sequential version (also with duplicates).
+    /// \param policy[in]: execution policy
+    /// \param first1[in]: iterator to the beginning of the first range
+    /// \param last1[in]: iterator to the end of the first range
+    /// \param first2[in]: iterator to the beginning of the second range
+    /// \param last2[in]: iterator to the end of the second range
+    /// \param d_first[out]: iterator to the beginning of the destination range
+    /// \param comp[in]: comparison function object
+    /// \return iterator to the end of the constructed range
+    template<class ExecPolicy,
+             class RandIt1,
+             class RandIt2,
+             class RandIt3,
+             class Compare = std::less<>,
+             const AlgorithmSetIntersectionConfig &config = algorithmSetIntersectionConfig>
+#if __cplusplus > 201709L
+    requires ExecutionPolicy<ExecPolicy> &&
+             std::random_access_iterator<RandIt1> &&
+             std::random_access_iterator<RandIt2> &&
+             std::random_access_iterator<RandIt3>
+#endif
+    RandIt3 set_intersection(ExecPolicy &&policy,
+                             RandIt1 first1,
+                             RandIt1 last1,
+                             RandIt2 first2,
+                             RandIt2 last2,
+                             RandIt3 d_first,
+                             Compare comp = Compare{}) noexcept {
+        using T = typename std::iterator_traits<RandIt1>::value_type;
+        const size_t n1 = static_cast<size_t>(std::distance(first1, last1));
+        const uint32_t nthreads = should_par(policy, config, n1);
+        if (is_seq<ExecPolicy>(policy) || nthreads < 2) {
+            return cryptanalysislib::set_intersection(first1, last1, first2, last2, d_first, comp);
+        }
+
+        // chunk boundaries in the first range, never between equivalent elements
+        std::vector<size_t> b1(nthreads + 1), b2(nthreads + 1);
+        b1[0] = 0; b2[0] = 0;
+        b1[nthreads] = n1; b2[nthreads] = static_cast<size_t>(std::distance(first2, last2));
+        for (uint32_t k = 1; k < nthreads; ++k) {
+            size_t s = (n1 * k) / nthreads;
+            if (s < b1[k - 1]) { s = b1[k - 1]; }
+            while ((s > 0) && (s < n1) && !comp(first1[s - 1], first1[s])) { s += 1; }
+            b1[k] = s;
+
+            // first element of the second range which is not less than `first1[s]`
+            size_t lo = b2[k - 1], hi = b2[nthreads];
+            while ((s < n1) && (lo < hi)) {
+                const size_t mid = lo + (hi - lo) / 2;
+                if (comp(first2[mid], first1[s])) { lo = mid + 1; } else { hi = mid; }
+            }
+            b2[k] = (s == n1) ? b2[nthreads] : lo;
+        }
+
+        auto &task_pool = *policy.pool();
+        std::vector<std::vector<T>> tmp(nthreads);
+        std::vector<std::future<size_t>> futures;
+        for (uint32_t k = 0; k < nthreads; ++k) {
+            futures.emplace_back(task_pool.submit([&, k]() {
+                const size_t l1 = b1[k + 1] - b1[k], l2 = b2[k + 1] - b2[k];
+                tmp[k].resize(l1 < l2 ? l1 : l2);
+                const auto e = cryptanalysislib::set_intersection(first1 + b1[k], first1 + b1[k + 1],
+                                                                  first2 + b2[k], first2 + b2[k + 1],
+                                                                  tmp[k].begin(), comp);
+                return static_cast<size_t>(e - tmp[k].begin());
+            }));
+        }
+
+        std::vector<size_t> c(nthreads);
+        for (uint32_t k = 0; k < nthreads; ++k) { c[k] = futures[k].get(); }
+
+        for (uint32_t k = 0; k < nthreads; ++k) {
+            d_first = cryptanalysislib::copy(tmp[k].begin(), tmp[k].begin() + c[k], d_first);
+        }
+        return d_first;
+    }
+
 }; // end namespace
