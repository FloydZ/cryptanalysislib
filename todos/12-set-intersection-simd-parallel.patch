+                const uint32_t match = (uint32_t)_mm256_movemask_ps(_mm256_castsi256_ps(eq));
+                const uint32_t k = cryptanalysislib::popcount::popcount(match);
+                const __m256i perm = _mm256_loadu_si256((const __m256i *)remove_u32_lut[match].data());
+                _mm256_store_si256((__m256i *)buf, _mm256_permutevar8x32_epi32(va, perm));
+                cryptanalysislib::memcpy(out + c, buf, k);
+                c += k;
+
+                const uint32_t amax = a[i + L - 1], bmax = b[j + L - 1];
+                if (amax <= bmax) { i += L; }
+                if (bmax <= amax) { j += L; }
+            }
+#endif
+            return c + intersect_u32_serial(a + i, b + j, n - i, m - j, out + c);
+        }
