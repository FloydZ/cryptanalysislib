+TEST(SubSetSum, join2lists_on_iT_v2_hashmap_out_multithreaded) {
+	Matrix A; A.random();
+	constexpr uint32_t k_lower=0, k_higher=8, k_higher2=16;
+	constexpr uint32_t p = 2;
+	constexpr uint32_t nthreads = 2;
+
+	constexpr size_t baselist_size = sum_bc(n/2, p);
+	List l1{baselist_size, nthreads}, l2{baselist_size, nthreads};
+
+	using Enumerator = BinaryLexicographicEnumerator<List, n/2, p>;
+	Enumerator e{A};
+	e.run <std::nullptr_t, std::nullptr_t, std::nullptr_t>
+			(&l1, &l2, n/2);
+
+	using D = typename Label::DataType;
+	using E = std::pair<size_t, size_t>;
+	constexpr static SimpleHashMapConfig simpleHashMapConfigL0 {
+			100, 1ul<<(k_higher-k_lower), nthreads
+	};
+	constexpr static SimpleHashMapConfig simpleHashMapConfigL1 {
+			100, 1ul<<(k_higher2-k_higher), nthreads
+	};
+	using HML0 = SimpleHashMap<D, size_t, simpleHashMapConfigL0, Hash<D, k_lower, k_higher, 2>>;
+	using HML1 = SimpleHashMap<D,      E, simpleHashMapConfigL1, Hash<D, k_higher, k_higher2, 2>>;
+	HML0 *hml0 = new HML0{};
+	HML1 *hml1 = new HML1{};
+
+	Label target;
+	target.random();
+
+	auto f = [](HML1 &out, const List &L1, const List &L2, const size_t i, const size_t j) {
+		Label s;
+		Label::add(s, L1[i].label, L2[j].label);
+		out.insert(s.value(), E{i, j});
+		return false;
+	};
+
+	Tree t{1, A, 0};
+	const size_t found = t.template join2lists_on_iT_v2
+			<k_lower, k_higher, 100, nthreads>
+			(par_if(true), *hml1, l1, l2, *hml0, target, true, f);
+
+	// brute force
+	size_t num = 0;
+	Label s;
+	for (size_t i = 0; i < l1.load(); ++i) {
+		for (size_t j = 0; j < l2.load(); ++j) {
+			Label::add(s, l1[i].label, l2[j].label);
+			num += s.is_equal(target, k_lower, k_higher);
+		}
+	}
+
+	EXPECT_GT(num, 0);
+	EXPECT_EQ(found, num);
+	EXPECT_EQ(hml1->load(), num);
+	for (size_t i = 0; i < HML1::nrbuckets; ++i) {
+		for (size_t j = 0; j < hml1->load_without_hash(i); ++j) {
+			const E a = (*hml1)[i*HML1::bucketsize + j];
+			Label::add(s, l1[a.first].label, l2[a.second].label);
+			EXPECT_TRUE(s.is_equal(target, k_lower, k_higher));
+		}
+	}
+
+	// the sequential policy computes the same
+	const size_t found2 = t.template join2lists_on_iT_v2
+			<k_lower, k_higher, 100, nthreads>
+			(par_if(false), *hml1, l1, l2, *hml0, target, true, f);
+	EXPECT_EQ(found2, num);
+	EXPECT_EQ(hml1->load(), num);
+
+	delete hml0;
+	delete hml1;
+}
