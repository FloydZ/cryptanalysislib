+TEST(SubSetSum, join4lists_twolists_on_iT_v2_multithreaded) {
+	Matrix A; A.random();
+	constexpr uint32_t k_lower1=0, k_higher1=8, k_lower2=8, k_higher2=16;
+	constexpr uint32_t p = 2;
+	constexpr uint32_t nthreads = 2;
+
+	constexpr size_t baselist_size = sum_bc(n/2, p);
+	List out{1u<<8}, l1{baselist_size, nthreads}, l2{baselist_size, nthreads};
+
+	using Enumerator = BinaryLexicographicEnumerator<List, n/2, p>;
+	Enumerator e{A};
+	e.run <std::nullptr_t, std::nullptr_t, std::nullptr_t>
+			(&l1, &l2, n/2);
+
+	Label target;
+	target.random();
+
+	Tree t{1, A, 0};
+	t.template join4lists_twolists_on_iT_v2
+			<k_lower1, k_higher1, k_lower2, k_higher2, 100, nthreads>
+			(par_if(true), out, l1, l2, target);
+
+	// NOTE: 2^14 pairs matching on 8 bits: 2^6 intermediate elements, then
+	// 	2^14 pairs matching on 8 bits, each matching 2^6 elements on 8 bits:
+	// 	2^4 outputs are expected
+	EXPECT_GT(out.load(), 0);
+	for (uint64_t i = 0; i < out.load(); ++i) {
+		EXPECT_TRUE(out[i].label.is_equal(target, k_lower1, k_higher2));
+	}
+}
