+TEST(SubSetSum, twolevel_streamjoin_on_iT_hashmap_v2_multithreaded) {
+	Matrix A; A.random();
+	constexpr uint32_t k_lower1=0, k_higher1=8, k_lower2=8, k_higher2=16;
+	constexpr uint32_t p = 2;
+	constexpr uint32_t nthreads = 2;
+
+	constexpr size_t baselist_size = sum_bc(n/2, p);
+	List l1{baselist_size, nthreads}, l2{baselist_size, nthreads};
+
+	using Enumerator = BinaryLexicographicEnumerator<List, n/2, p>;
+	Enumerator e{A};
+	e.run <std::nullptr_t, std::nullptr_t, std::nullptr_t>
+			(&l1, &l2, n/2);
+
+	using D = typename Label::DataType;
+	using E = std::pair<size_t, size_t>;
+	constexpr static SimpleHashMapConfig simpleHashMapConfigL0 {
+			100, 1ul<<(k_higher1-k_lower1), 1
+	};
+	constexpr static SimpleHashMapConfig simpleHashMapConfigL1 {
+			100, 1ul<<(k_higher2-k_lower2), 1
+	};
+	using HML0 = SimpleHashMap<D, size_t, simpleHashMapConfigL0, Hash<D, k_lower1, k_higher1, 2>>;
+	using HML1 = SimpleHashMap<D,      E, simpleHashMapConfigL1, Hash<D, k_lower2, k_higher2, 2>>;
+	HML0 *hml0 = new HML0{};
+	HML1 *hml1 = new HML1{};
+
+	Label target, iT, t1;
+	target.random();
+	iT.random(0, 1ull << k_higher1);
+	Label::sub(t1, target, iT);
+
+	Tree t{1, A, 0};
+	t.template join2lists_on_iT_v2
+			<k_lower1, k_higher1>
+			(*hml1, l1, l2, *hml0, iT, true);
+
+	std::atomic<size_t> calls1 = 0, calls2 = 0;
+	List out{1};
+	const size_t ret1 = t.template twolevel_streamjoin_on_iT_hashmap_v2
+			<k_lower1, k_higher1, k_lower2, k_higher2>
+			(out, *hml1, l1, l2, *hml0, target, t1,
+			 [&calls1](List &, Element &, Element &, size_t, size_t, size_t, size_t) {
+				 calls1 += 1;
+				 return false;
+			 });
+
+	const size_t ret2 = t.template twolevel_streamjoin_on_iT_hashmap_v2
+			<k_lower1, k_higher1, k_lower2, k_higher2, nthreads>
+			(par_if(true), out, *hml1, l1, l2, *hml0, target, t1,
+			 [&calls2, &target](List &, Element &e1, Element &e2, size_t, size_t, size_t, size_t) {
+				 Label s;
+				 Label::add(s, e1.label, e2.label);
+				 EXPECT_TRUE(s.is_equal(target, k_lower1, k_higher2));
+				 calls2 += 1;
+				 return false;
+			 });
+
+	EXPECT_GT(ret1, 0);
+	EXPECT_EQ(ret1, calls1);
+	EXPECT_EQ(ret1, ret2);
+	EXPECT_EQ(ret2, calls2);
+
+	delete hml0;
+	delete hml1;
+}
