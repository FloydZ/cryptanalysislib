+TEST(SubSetSum, twolevel_streamjoin_on_iT_hashmap_v2_hashmap_out) {
+	Matrix A; A.random();
+	constexpr uint32_t k_lower1=0, k_higher1=4;
+	constexpr uint32_t k_lower2=4, k_higher2=8;
+	constexpr uint32_t p = n/4;
+
+	constexpr size_t baselist_size = sum_bc(n/2, p);
+	List l1{baselist_size}, l2{baselist_size};
+
+	using Enumerator = BinaryLexicographicEnumerator<List, n/2, p>;
+	Enumerator e{A};
+	e.template run <std::nullptr_t, std::nullptr_t, std::nullptr_t>
+			(&l1, &l2, n/2);
+
+	using D = typename Label::DataType;
+	using E = std::pair<size_t, size_t>;
+	using F = std::pair<E, E>;
+	constexpr static SimpleHashMapConfig simpleHashMapConfigL0 {
+			100, 1ul<<(k_higher1-k_lower1), 1
+	};
+	constexpr static SimpleHashMapConfig simpleHashMapConfigL1 {
+			1000, 1ul<<(k_higher2-k_lower2), 1
+	};
+	using HML0 = SimpleHashMap<D, size_t, simpleHashMapConfigL0, Hash<D, k_lower1, k_higher1, 2>>;
+	using HML1 = SimpleHashMap<D,      E, simpleHashMapConfigL1, Hash<D, k_lower2, k_higher2, 2>>;
+	using HML2 = SimpleHashMap<D,      F, simpleHashMapConfigL1, Hash<D, k_lower2, k_higher2, 2>>;
+	HML0 *hml0 = new HML0{};
+	HML1 *hml1 = new HML1{};
+	HML2 *hml2 = new HML2{};
+
+	Label target, iT, t1;
+	std::vector<uint32_t> weights(n/2);
+	generate_subsetsum_instance(target, weights, A, n);
+	iT.random(0, 1ull << k_higher1);
+	Label::sub(t1, target, iT);
+
+	Tree t{1, A, 0};
+	t.template join2lists_on_iT_v2
+			<k_lower1, k_higher1>
+			(*hml1, l1, l2, *hml0, iT, true);
+
+	const size_t ret = t.template twolevel_streamjoin_on_iT_hashmap_v2
+			<k_lower1, k_higher1, k_lower2, k_higher2>
+			(*hml2, *hml1, l1, l2, *hml0, target, t1);
+	EXPECT_GT(ret, 0);
+	EXPECT_GT(hml2->load(), 0);
+
+	// every inserted match is a sum of four base list elements, which is the
+	// target on [k_lower1, k_higher2)
+	for (size_t i = 0; i < HML2::nrbuckets; ++i) {
+		for (size_t j = 0; j < hml2->load_without_hash(i); ++j) {
+			const F f = (*hml2)[i*HML2::bucketsize + j];
+			Label s;
+			Label::add(s, l1[f.first.first].label, l2[f.first.second].label);
+			Label::add(s, s, l1[f.second.first].label);
+			Label::add(s, s, l2[f.second.second].label);
+			EXPECT_TRUE(s.is_equal(target, k_lower1, k_higher2));
+		}
+	}
+
+	// a filter which rejects everything: same matches, nothing is inserted
+	hml2->clear();
+	const size_t ret2 = t.template twolevel_streamjoin_on_iT_hashmap_v2
+			<k_lower1, k_higher1, k_lower2, k_higher2>
+			(*hml2, *hml1, l1, l2, *hml0, target, t1,
+			 [](const Label &, const size_t, const size_t, const size_t, const size_t) {
+				 return false;
+			 });
+	EXPECT_EQ(ret, ret2);
+	EXPECT_EQ(hml2->load(), 0);
+
+	delete hml0;
+	delete hml1;
+	delete hml2;
+}
