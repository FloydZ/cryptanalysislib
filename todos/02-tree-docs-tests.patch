+TEST(TreeTest, twolevel_streamjoin_on_iT) {
+	constexpr uint32_t basesize = 8u;
+	BinaryMatrix A;
+	A.identity();
+	const uint32_t k_lower1 = 0, k_upper1 = n/2, k_lower2 = n/2, k_upper2 = n;
+
+	BinaryList out{1u<<16}, iL{0}, l1{0}, l2{0};
+	l1.random(1u << basesize, A);
+	l2.random(1u << basesize, A);
+	iL.random(1u << basesize, A);
+	// NOTE: `L1` must be sorted by the caller
+	l1.sort_level(k_lower1, k_upper1);
+
+	BinaryLabel target {};
+	target.random();
+
+	BinaryTree t{1, A, 0};
+	size_t calls = 0;
+	const size_t ret = t.twolevel_streamjoin_on_iT(out, iL, l1, l2, target,
+			k_lower1, k_upper1, k_lower2, k_upper2, true,
+			[&calls](BinaryList &out, BinaryList &iL, BinaryElement &e, const size_t l) {
+				out.add_and_append(e, iL[l], 0, n, -1u);
+				calls += 1;
+				return false;
+			});
+
+	EXPECT_EQ(ret, calls);
+	EXPECT_EQ(ret, out.load());
+	// NOTE: 2^8 * 2^8 pairs matching on n/2=5 bits: 2^11, each matching
+	// 	2^8 elements of `iL` on the other 5 bits: 2^14 expected
+	EXPECT_GT(out.load(), 1u<<13);
+	EXPECT_LT(out.load(), 1u<<15);
+	for (uint64_t i = 0; i < out.load(); ++i) {
+		EXPECT_TRUE(out[i].is_correct(A));
+		EXPECT_TRUE(BinaryLabel::cmp(out[i].label, target, k_lower2, k_upper2));
+	}
+
+	// `f` returns true: the join stops after the first collision
+	BinaryList out2{1u<<4};
+	const size_t ret2 = t.twolevel_streamjoin_on_iT(out2, iL, l1, l2, target,
+			k_lower1, k_upper1, k_lower2, k_upper2, false,
+			[](BinaryList &out, BinaryList &iL, BinaryElement &e, const size_t l) {
+				out.add_and_append(e, iL[l], 0, n, -1u);
+				return true;
+			});
+	EXPECT_EQ(ret2, 1u);
+	EXPECT_EQ(out2.load(), 1u);
+}
